/// Status de geraÃ§Ã£o do relatÃ³rio
enum ReportStatus {
  GENERATING   /// Em produÃ§Ã£o
  READY        /// Pronto para download
  FAILED       /// Falhou (ver errorMessage)
}

/// Registro de um relatÃ³rio mensal gerado (1 por cliente/mÃªs)
model MonthlyReport {
  id          String        @id @default(cuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// PerÃ­odo do relatÃ³rio (ex.: "2026-07")
  period      String

  /// Caminho relativo do PDF (a partir de backend/uploads/)
  pdfPath     String?

  /// Resumo em JSON (total honorÃ¡rios, transaÃ§Ãµes, tempo economizado, etc.)
  summary     Json?

  status      ReportStatus  @default(GENERATING)
  errorMessage String?      @db.Text

  /// VÃ­nculo com o AutomationRun que gerou (opcional â€” geraÃ§Ã£o manual nÃ£o tem run)
  runId       String?
  run         AutomationRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  /// Quem gerou (userId se manual, null se cron)
  generatedBy String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([companyId, clientId, period])  /// 1 relatÃ³rio por cliente/mÃªs/tenant
  @@index([companyId, period])
  @@index([clientId])
  @@map("monthly_reports")
}
