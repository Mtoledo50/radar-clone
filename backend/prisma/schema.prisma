generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =================================================================
// 🏢 EMPRESA (TENANT)
// =================================================================
model Company {
  id              String   @id @default(uuid())
  name            String   
  cnpj            String?  @unique
  state           String?
  
  plan            String   @default("BASIC") 
  allowedModules  String[] @default(["dashboard", "pessoas", "clientes"]) 
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  users           User[]
  turnoverDistributions TurnoverSectorDistribution[] 
  
  // Relações para Planos Comerciais
  serviceCategories ServiceCategory[]
  serviceItems      ServiceItem[]
  commercialPlans   CommercialPlan[]
  
  // Relações para Calculadora de Preço
  pricingConfigs      PricingConfig?
  pricingHourRules    PricingHourRule[]
  pricingCalculations PricingCalculation[]

  // 📄 PROPOSTA COMERCIAL (Link Público + PDF)
  proposals           Proposal[]
  
  @@map("companies")
}

// =================================================================
// 👤 USUÁRIO
// =================================================================
model User {
  id                    String                @id @default(uuid())
  name                  String
  email                 String                @unique
  password              String
  role                  String                @default("CLIENTE") 
  companyId             String
  company               Company               @relation(fields: [companyId], references: [id])
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  companyProfile        CompanyProfile?
  employees             Employee[]
  clients               Client[]
  pricings              Pricing[]
  plannings             Planning[]
  financialTransactions FinancialTransaction[]
  turnoverMonthly       TurnoverMonthly[]
  sectors               Sector[]
  dismissalReasons      DismissalReason[]
  positions             Position[]
  resignations          Resignation[]
  turnoverDistributions TurnoverSectorDistribution[] 
  
  // 🔥 NOVA RELAÇÃO: Cálculos de precificação feitos por este usuário
  pricingCalculations   PricingCalculation[]
  
  // 📄 PROPOSTA COMERCIAL (Link Público + PDF)
  proposals           Proposal[]
  
  @@index([companyId])
  @@map("users")
}

// =================================================================
// 📊 PERFIL DA EMPRESA
// =================================================================
model CompanyProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id])
  
  razaoSocial         String?
  cnpj                String?
  estado              String?
  
  softwareConsultoria Boolean  @default(false)
  softwareContabil    Boolean  @default(false)
  softwareFiscal      Boolean  @default(false)
  
  clientesHoje        Int      @default(0)
  clientesAno         Int      @default(0)
  funcionariosHoje    Int      @default(0)
  funcionariosAno     Int      @default(0)
  visaoEmpresa        String?
  maiorDesafio        String?
  compromisso         String?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("company_profiles")
}

// =================================================================
// 👷 COLABORADOR
// =================================================================
model Employee {
  id              String   @id @default(uuid())
  userId          String
  companyId       String   
  user            User     @relation(fields: [userId], references: [id])
  
  name            String
  email           String?
  phone           String?
  position        String
  department      String?
  admissionDate   DateTime
  dismissalDate   DateTime?
  salary          Float?
  status          String   @default("ACTIVE")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([companyId])
  @@map("employees")
}

// =================================================================
// 🏢 CLIENTE
// =================================================================
model Client {
  id                    String                @id @default(uuid())
  userId                String
  companyId             String                
  user                  User                  @relation(fields: [userId], references: [id])
  
  companyName           String
  cnpj                  String?
  serviceType           String                @default("CONTABIL")
  monthlyFee            Float
  status                String                @default("ATIVO")
  
  startDate             DateTime
  endDate               DateTime?
  
  contactName           String?
  contactEmail          String?
  contactPhone          String?
  
  observations          String?               @db.Text
  
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  
  financialTransactions FinancialTransaction[]

  @@index([userId])
  @@index([companyId])
  @@map("clients")
}

// =================================================================
// 💰 PRECIFICAÇÃO (Antiga)
// =================================================================
model Pricing {
  id              String   @id @default(uuid())
  userId          String
  companyId       String   
  user            User     @relation(fields: [userId], references: [id])
  
  title           String
  serviceType     String   @default("CONTABIL")
  complexity      String   @default("MEDIA")
  
  estimatedHours  Float
  hourlyRate      Float
  softwareCost    Float    @default(0)
  profitMargin    Float    @default(20)
  
  finalValue      Float
  status          String   @default("RASCUNHO")
  
  observations    String?  @db.Text
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([companyId])
  @@map("pricings")
}

// =================================================================
// 📋 PLANEJAMENTO
// =================================================================
model Planning {
  id              String   @id @default(uuid())
  userId          String
  companyId       String   
  user            User     @relation(fields: [userId], references: [id])
  
  title           String
  description     String?  @db.Text
  category        String   @default("GERAL")
  targetDate      DateTime
  status          String   @default("PENDENTE")
  progress        Float    @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([companyId])
  @@map("plannings")
}

// =================================================================
// 💸 TRANSAÇÃO FINANCEIRA
// =================================================================
model FinancialTransaction {
  id          String   @id @default(uuid())
  userId      String
  companyId   String   
  clientId    String?
  
  type        String   
  category    String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime @default(now())
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([companyId])
  @@index([userId, date])
  @@index([userId, type])
  @@index([clientId])
  @@map("financial_transactions")
}

// =================================================================
// 📊 TURNOVER - Dados Mensais
// =================================================================
model TurnoverMonthly {
  id          String   @id @default(uuid())
  userId      String
  companyId   String   
  year        Int
  month       Int      
  
  cltInitial      Int @default(0)
  cltAdmissions   Int @default(0)
  cltDismissals   Int @default(0)
  
  internInitial   Int @default(0)
  internAdmissions Int @default(0)
  internDismissals Int @default(0)
  
  thirdInitial    Int @default(0)
  thirdAdmissions Int @default(0)
  thirdDismissals Int @default(0)
  
  partnerInitial  Int @default(0)
  partnerAdmissions Int @default(0)
  partnerDismissals Int @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([companyId, year, month])
  @@index([userId])
  @@index([companyId])
  @@map("turnover_monthly")
}

// =================================================================
// 🏢 SETOR
// =================================================================
model Sector {
  id        String   @id @default(uuid())
  userId    String
  companyId String   
  name      String
  mandatory Boolean  @default(false)
  order     Int      @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user                User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cells               Cell[]
  resignations        Resignation[]
  turnoverDistributions TurnoverSectorDistribution[] 
  
  @@index([userId])
  @@index([companyId])
  @@map("sectors")
}

// =================================================================
// 🔲 CÉLULA DE TRABALHO
// =================================================================
model Cell {
  id        String   @id @default(uuid())
  sectorId  String
  name      String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  sector    Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  
  @@map("cells")
}

// =================================================================
// 📋 MOTIVO DE DESLIGAMENTO
// =================================================================
model DismissalReason {
  id          String   @id @default(uuid())
  userId      String
  companyId   String   
  name        String
  description String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resignations Resignation[]
  
  @@index([userId])
  @@index([companyId])
  @@map("dismissal_reasons")
}

// =================================================================
// 💼 CARGO
// =================================================================
model Position {
  id        String   @id @default(uuid())
  userId    String
  companyId String   
  name      String
  description String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resignations Resignation[]
  
  @@index([userId])
  @@index([companyId])
  @@map("positions")
}

// =================================================================
// 📤 RESCISÃO
// =================================================================
model Resignation {
  id              String   @id @default(uuid())
  userId          String
  companyId       String   
  
  employeeName    String
  admissionDate   DateTime
  dismissalDate   DateTime
  
  sectorId        String?
  sector          Sector?  @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  
  cellId          String?
  
  positionId      String?
  position        Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  
  contractType    String   
  dismissalReasonId String?
  dismissalReason DismissalReason? @relation(fields: [dismissalReasonId], references: [id], onDelete: SetNull)
  
  observations    String?  @db.Text
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([companyId])
  @@index([dismissalDate])
  @@map("resignations")
}

// =================================================================
// 📊 DISTRIBUIÇÃO DE TURNOVER POR SETOR
// =================================================================
model TurnoverSectorDistribution {
  id          String   @id @default(uuid())
  companyId   String
  userId      String
  year        Int
  month       Int      
  sectorId    String
  
  initial     Int      @default(0)
  admissions  Int      @default(0)
  dismissals  Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector      Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  
  @@unique([companyId, year, month, sectorId])
  @@index([companyId])
  @@map("turnover_sector_distribution")
}

// =================================================================
// 📦 MÓDULO DE PLANOS COMERCIAIS (Precificação)
// =================================================================

// Categoria de serviços (ex: "Fiscal e Tributário", "Departamento Pessoal")
model ServiceCategory {
  id          String        @id @default(uuid())
  companyId   String
  name        String
  icon        String?
  order       Int           @default(0)
  description String?
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items       ServiceItem[]
  
  @@index([companyId])
  @@map("service_categories")
}

// Item de serviço individual (ex: "Apuração mensal de impostos")
model ServiceItem {
  id          String            @id @default(uuid())
  companyId   String
  categoryId  String
  name        String
  description String?
  order       Int               @default(0)
  
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    ServiceCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  planItems   PlanServiceItem[]
  
  @@index([companyId])
  @@index([categoryId])
  @@map("service_items")
}

// Plano comercial (ex: START, PRIME, BLACK)
model CommercialPlan {
  id            String            @id @default(uuid())
  companyId     String
  name          String
  multiplier    Float
  order         Int               @default(0)
  isIndependent Boolean           @default(false)
  color         String?
  badge         String?
  description   String?
  
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planItems     PlanServiceItem[]
  
  @@index([companyId])
  @@map("commercial_plans")
}

// Tabela pivô: relaciona planos com itens de serviço
model PlanServiceItem {
  id            String        @id @default(uuid())
  planId        String
  serviceItemId String
  
  createdAt     DateTime      @default(now())
  
  plan          CommercialPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  serviceItem   ServiceItem    @relation(fields: [serviceItemId], references: [id], onDelete: Cascade)
  
  @@unique([planId, serviceItemId])
  @@index([planId])
  @@index([serviceItemId])
  @@map("plan_service_items")
}

// =================================================================
// 📊 CONFIGURAÇÃO DE PRECIFICAÇÃO (Custos da Empresa)
// =================================================================

// Armazena os parâmetros de custo e margem da empresa.
model PricingConfig {
  id                    String   @id @default(uuid())
  companyId             String   @unique
  
  // Custo do Colaborador
  salaryAverage         Float    @default(4000)
  chargesPercent        Float    @default(69)
  hoursPerMonth         Float    @default(160)
  livesPerEmployee      Float    @default(150)
  
  // Deduções / Markup
  taxesPercent          Float    @default(10)
  backOfficePercent     Float    @default(4)
  adminPercent          Float    @default(5)
  marginFC              Float    @default(15)
  marginDP              Float    @default(15)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  @@map("pricing_configs")
}

// =================================================================
// 📊 REGRAS DE HORAS (Por Perfil de Cliente)
// =================================================================

// Define quantas horas fiscais e contábeis são necessárias por perfil
model PricingHourRule {
  id              String   @id @default(uuid())
  companyId       String
  
  regime          String
  activity        String
  annex           String?
  revenueMin      Float    @default(0)
  revenueMax      Float    @default(0)
  
  hoursFiscal     Float    @default(0)
  hoursAccounting Float    @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  @@index([companyId])
  @@index([regime, activity])
  @@map("pricing_hour_rules")
}

// =================================================================
// 📊 CÁLCULO DE PREÇO SALVO (Proposta/Cálculo)
// =================================================================

// Armazena cada cálculo realizado, permitindo recuperar e gerar propostas.
model PricingCalculation {
  id                String   @id @default(uuid())
  companyId         String
  userId            String
  
  // Identificação
  proposalNumber    String?
  clientName        String
  
  // Perfil do Cliente
  taxRegime         String
  annex             String?
  activity          String
  monthlyRevenue    Float
  employeeCount     Int
  dpMethod          String   @default("MARGIN")
  dpValue           Float    @default(0)
  hasBranches       Boolean  @default(false)
  hasErp            Boolean  @default(false)
  
  // Resultados do Cálculo
  hoursFiscal       Float    @default(0)
  hoursAccounting   Float    @default(0)
  costPerHour       Float    @default(0)
  basePrice         Float    @default(0)
  currentCharge     Float?
  
  // Planos calculados
  planPrices        Json?
  
  status            String   @default("DRAFT")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([companyId])
  @@index([status])
  @@map("pricing_calculations")
}
// =================================================================
// 📄 PROPOSTA COMERCIAL (Link Público + PDF)
// =================================================================

// Armazena cada proposta gerada para um cliente específico.
// Possui um slug único para acesso público sem login.
model Proposal {
  id                String   @id @default(uuid())
  companyId         String
  userId            String
  
  // Identificação
  proposalNumber    String   @unique // Ex: 0001/2026
  slug              String   @unique // URL amigável: querencia-amada-ltda
  clientName        String
  clientCnpj        String?
  
  // Dados do cálculo
  taxRegime         String
  activity          String
  monthlyRevenue    Float
  employeeCount     Int
  basePrice         Float
  
  // Planos incluídos na proposta
  includedPlans     Json     // Array: [{planId, planName, multiplier, finalPrice, items: []}]
  
  // Conteúdo da proposta (textos personalizados)
  aboutOffice       String?  @db.Text
  differentials     String?  @db.Text
  onboarding        String?  @db.Text
  commercialTerms   String?  @db.Text
  specificNote      String?  @db.Text
  
  // Status e rastreamento
  status            String   @default("DRAFT") // DRAFT, SENT, CLOSED, LOST
  sentAt            DateTime?
  closedAt          DateTime?
  closedPlanId      String?
  closedPrice       Float?
  lossReason        String?
  
  // Visualizações
  views             Int      @default(0)
  whatsappClicks    Int      @default(0)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([companyId])
  @@index([slug])
  @@index([status])
  @@map("proposals")
}

// Configuração do seed
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}