  name        String              // ex: "% da Meta de Clientes"
  description String?             // ex: "Progresso em relaÃ§Ã£o Ã  meta"
  formula     String              // ex: "(clientesHoje / clientesAno) * 100"
  target      Float?              // meta numÃ©rica (opcional)
