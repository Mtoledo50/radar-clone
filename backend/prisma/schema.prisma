// ðŸ“ TRILHA DE AUDITORIA (compliance contÃ¡bil â€” Pilar D)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
/// 100% das aÃ§Ãµes da Aurora (e do humano revisando) ficam aqui.
/// Ã‰ o "histÃ³rico de trabalho" auditÃ¡vel â€” exigÃªncia fiscal.
model AutomationAudit {
  id           String   @id @default(cuid())
  companyId    String

  actor        String   @default("AURORA")           /// AURORA | USER_<id>
  action       String                                /// AUTO_RECONCILED, USER_APPROVED...

  entity       String                                /// BankNfeMatch, AccountingEntry...
