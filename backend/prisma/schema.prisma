  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  
  @@index([companyId, status])
  @@index([companyId, deletedAt])
  @@map("projects")
}

/// Tarefa (unidade de trabalho)
model Task {
  id          String       @id @default(uuid())
