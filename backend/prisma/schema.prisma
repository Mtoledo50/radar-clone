// =================================================================
// 📦 MÓDULO FISCAL — ESTOQUE E APURAÇÃO DE ICMS
// =================================================================
// Fase 1: Upload de XMLs, Catálogo de Produtos, Kardex de Entradas
// Multi-tenant: todos os modelos possuem companyId
// Sprint 8: Vínculo por cliente (companyId + clientId)
// =================================================================

// -----------------------------------------------------------------
// ENUMS DO MÓDULO FISCAL
// -----------------------------------------------------------------

/// Tipo de documento fiscal processado
enum FiscalDocumentType {
  NFE_ENTRADA       /// NF-e de compra (entrada de mercadoria)
  NFE_DEVOLUCAO     /// NF-e de devolução de compra
  CTE               /// CT-e (conhecimento de transporte) — futuro
}

/// Status de processamento do XML
enum InvoiceStatus {
  UPLOADED          /// Arquivo recebido, aguardando parser
  PARSING           /// Parser em execução
  PARSED            /// Parser concluído com sucesso
  PARSE_ERROR       /// Falha no parser (XML inválido ou incompleto)
  AWAITING_REVIEW   /// Aguardando revisão humana (produtos não identificados)
  CONFIRMED         /// Confirmado e contabilizado no estoque
  CANCELLED         /// Cancelado pelo usuário
}

/// Tipo de movimentação no Kardex
enum MovementType {
  ENTRADA           /// Entrada via NF-e de compra
  DEVOLUCAO         /// Devolução de compra (reduz estoque)
  AJUSTE_POSITIVO   /// Ajuste manual de inventário (sobra)
  AJUSTE_NEGATIVO   /// Ajuste manual de inventário (quebra/perda)
  TRANSFERENCIA     /// Transferência entre filiais — futuro
  SALDO_INICIAL     /// 🆕 Sprint 10: saldo inicial importado (abertura do estoque)
}

/// Status de identificação de produto (matching)
enum ProductMatchStatus {
  IDENTIFIED        /// Produto já cadastrado, match automático
  SUGGESTED         /// IA sugeriu match, aguardando confirmação
  NEW               /// Produto novo, precisa ser cadastrado
}

// -----------------------------------------------------------------
// 🏢 FORNECEDOR
// -----------------------------------------------------------------
/// Fornecedor da empresa (extraído automaticamente dos XMLs)
/// Unique por companyId + cnpj (mesmo fornecedor não duplica)
model FiscalSupplier {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  cnpj              String              /// CNPJ do fornecedor (14 dígitos)
  name              String              /// Razão social
  tradeName         String?             /// Nome fantasia
  stateRegistration String?             /// Inscrição estadual
  state             String?             /// UF (para regras de ST)
  email             String?
  phone             String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  invoices          FiscalInvoice[]

  @@unique([companyId, cnpj])
  @@index([companyId, name])
  @@map("fiscal_suppliers")
}

// -----------------------------------------------------------------
// 📦 PRODUTO FISCAL (Catálogo)
// -----------------------------------------------------------------
/// Produto cadastrado no catálogo da empresa
/// Pode ser criado manualmente ou via parser de XML
/// ncm é obrigatório para apuração de ICMS
/// Sprint 8: vínculo opcional a um cliente específico (clientId)
/// Sprint 16: código opcional (nullable)
/// Sprint 19: unifiedCode (Código Unificado da planilha)
model FiscalProduct {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// 🆕 Sprint 8: cliente dono do produto (pode ser null = genérico)
  clientId          String?
  client            Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  code              String?   /// Código do produto (opcional - Sprint 16)
  unifiedCode       String?   /// 🆕 Sprint 19: Código Unificado da planilha (coluna extra)
  ean               String?   /// Código de barras (EAN-13)
  description       String    /// Descrição padronizada
  ncm               String    /// NCM (8 dígitos) — obrigatório
  unit              String    /// Unidade de medida (UN, KG, L, CX, etc.)

  averageCost       Decimal  @default(0) @db.Decimal(12, 4)  /// Custo médio atual
  currentStock      Decimal  @default(0) @db.Decimal(12, 4)  /// Saldo atual em estoque

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  invoiceItems      FiscalInvoiceItem[]
  movements         FiscalInventoryMovement[]
  balances          FiscalInventoryBalance[]

  @@unique([companyId, clientId, code])   // unique inclui clientId
  @@index([companyId, clientId])          // índice para filtro por cliente
  @@index([companyId, ncm])
  @@index([companyId, description])
  @@map("fiscal_products")
}

// -----------------------------------------------------------------
// 📄 NOTA FISCAL DE ENTRADA (Cabeçalho)
// -----------------------------------------------------------------
/// Representa uma NF-e de entrada processada
/// accessKey é a chave de 44 dígitos (única por empresa)
/// Guarda os totais da nota e o caminho do XML original
/// Sprint 8: vínculo opcional a um cliente específico (clientId)
model FiscalInvoice {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// 🆕 Sprint 8: cliente dono da nota (pode ser null = geral)
  clientId          String?
  client            Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  supplierId        String
  supplier          FiscalSupplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  documentType      FiscalDocumentType @default(NFE_ENTRADA)
  status            InvoiceStatus      @default(UPLOADED)

  number            String              /// Número da NF-e
  series            String              /// Série da NF-e
  accessKey         String              /// Chave de acesso (44 dígitos)
  emissionDate      DateTime            /// Data de emissão
  entryDate         DateTime?           /// Data de entrada no sistema

  cfop              String?             /// CFOP principal da nota
  natOp             String?             /// Natureza da operação

  totalValue        Decimal  @default(0) @db.Decimal(12, 2)
  discountValue     Decimal  @default(0) @db.Decimal(12, 2)
  freightValue      Decimal  @default(0) @db.Decimal(12, 2)
  insuranceValue    Decimal  @default(0) @db.Decimal(12, 2)
  otherValues       Decimal  @default(0) @db.Decimal(12, 2)

  icmsBase          Decimal  @default(0) @db.Decimal(12, 2)
  icmsValue         Decimal  @default(0) @db.Decimal(12, 2)
  icmsStValue       Decimal  @default(0) @db.Decimal(12, 2)
  ipiValue          Decimal  @default(0) @db.Decimal(12, 2)
  pisValue          Decimal  @default(0) @db.Decimal(12, 2)
  cofinsValue       Decimal  @default(0) @db.Decimal(12, 2)

  xmlOriginalUrl    String?             /// Caminho do XML original (S3 ou local)
  errorMessage      String?             /// Mensagem de erro (se status = PARSE_ERROR)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items             FiscalInvoiceItem[]
  // ✅ Relação oposta com movimentos de estoque
  movements         FiscalInventoryMovement[]
  bankMatches       BankNfeMatch[]   // 🆕 ADICIONAR ESTA LINHA


  @@unique([companyId, accessKey])
  @@index([companyId, clientId])          // 🆕 índice para filtro por cliente
  @@index([companyId, supplierId])
  @@index([companyId, emissionDate])
  @@index([companyId, status])
  @@map("fiscal_invoices")
}

// -----------------------------------------------------------------
// 📦 ITENS DA NOTA FISCAL
// -----------------------------------------------------------------
/// Cada item (produto) dentro de uma NF-e
/// Guarda os impostos individuais por item (necessário para apuração)
/// productMatchStatus indica se o produto foi identificado automaticamente
model FiscalInvoiceItem {
  id                String   @id @default(cuid())
  invoiceId         String
  invoice           FiscalInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId         String?
  product           FiscalProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productMatchStatus ProductMatchStatus @default(NEW)

  itemNumber        Int                 /// Número do item na NF (1, 2, 3...)
  supplierCode      String?             /// Código do produto no fornecedor
  description       String              /// Descrição do produto na NF

  ncm               String              /// NCM do item
  cfop              String              /// CFOP do item
  cst               String?             /// CST do ICMS (Lucro Presumido/Real)
  csosn             String?             /// CSOSN (Simples Nacional)

  quantity          Decimal  @db.Decimal(12, 4)
  unitValue         Decimal  @db.Decimal(12, 4)
  totalValue        Decimal  @db.Decimal(12, 2)
  discount          Decimal  @default(0) @db.Decimal(12, 2)

  icmsBase          Decimal  @default(0) @db.Decimal(12, 2)
  icmsRate          Decimal  @default(0) @db.Decimal(5, 2)
  icmsValue         Decimal  @default(0) @db.Decimal(12, 2)
  icmsStBase        Decimal  @default(0) @db.Decimal(12, 2)
  icmsStValue       Decimal  @default(0) @db.Decimal(12, 2)
  ipiBase           Decimal  @default(0) @db.Decimal(12, 2)
  ipiRate           Decimal  @default(0) @db.Decimal(5, 2)
  ipiValue          Decimal  @default(0) @db.Decimal(12, 2)
  pisBase           Decimal  @default(0) @db.Decimal(12, 2)
  pisRate           Decimal  @default(0) @db.Decimal(5, 2)
  pisValue          Decimal  @default(0) @db.Decimal(12, 2)
  cofinsBase        Decimal  @default(0) @db.Decimal(12, 2)
  cofinsRate        Decimal  @default(0) @db.Decimal(5, 2)
  cofinsValue       Decimal  @default(0) @db.Decimal(12, 2)

  createdAt         DateTime @default(now())
  
  @@unique([invoiceId, itemNumber])
  @@index([productId])
  @@index([ncm])
  @@map("fiscal_invoice_items")
}

// -----------------------------------------------------------------
// 📊 MOVIMENTAÇÃO DE ESTOQUE (Kardex)
// -----------------------------------------------------------------
/// Cada entrada/saída de produto no estoque
/// Registra o custo unitário e o custo médio APÓS a movimentação
/// Essencial para apuração de ICMS e Bloco H do SPED
/// Sprint 8: vínculo opcional a um cliente específico (clientId)
model FiscalInventoryMovement {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// 🆕 Sprint 8: cliente dono da movimentação
  clientId          String?
  client            Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  productId         String
  product           FiscalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  invoiceId         String?             /// Null em ajustes manuais
  invoice           FiscalInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  type              MovementType
  date              DateTime            /// Data da movimentação
  quantity          Decimal  @db.Decimal(12, 4)  /// Quantidade (+ entrada, - saída)
  unitCost          Decimal  @db.Decimal(12, 4)  /// Custo unitário da movimentação
  totalCost         Decimal  @db.Decimal(12, 2)  /// Custo total
  averageCostAfter  Decimal  @db.Decimal(12, 4)  /// Custo médio APÓS a movimentação

  reason            String?             /// Justificativa (ajustes manuais)
  userId            String?             /// Usuário que registrou (auditoria)

  createdAt         DateTime @default(now())

  @@index([companyId, clientId])          // 🆕 índice para filtro por cliente
  @@index([companyId, productId, date])
  @@index([companyId, date])
  @@index([invoiceId])
  @@map("fiscal_inventory_movements")
}

// -----------------------------------------------------------------
// 💰 SALDO MENSAL DE ESTOQUE (Snapshot)
// -----------------------------------------------------------------
/// Snapshot mensal do estoque por produto
/// Usado para o Bloco H do SPED Fiscal (Inventário)
/// Calculado automaticamente ao final de cada mês
model FiscalInventoryBalance {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  productId         String
  product           FiscalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  year              Int
  month             Int                 /// 1-12

  initialQty        Decimal  @default(0) @db.Decimal(12, 4)
  initialValue      Decimal  @default(0) @db.Decimal(12, 2)
  inQty             Decimal  @default(0) @db.Decimal(12, 4)
  inValue           Decimal  @default(0) @db.Decimal(12, 2)
  outQty            Decimal  @default(0) @db.Decimal(12, 4)
  outValue          Decimal  @default(0) @db.Decimal(12, 2)
  finalQty          Decimal  @default(0) @db.Decimal(12, 4)
  finalValue        Decimal  @default(0) @db.Decimal(12, 2)
  averageCost       Decimal  @default(0) @db.Decimal(12, 4)

  updatedAt         DateTime @updatedAt

  @@unique([companyId, productId, year, month])
  @@index([companyId, year, month])
  @@map("fiscal_inventory_balances")
}
// =================================================================
// 🧮 APURAÇÃO DE ICMS MENSAL
// =================================================================
/// Fechamento mensal do ICMS por empresa (tenant)
/// Créditos são recalculados automaticamente das NF-e de entrada;
/// débitos são informados manualmente (vendas × alíquota)
/// Sprint 8: vínculo opcional a um cliente específico (clientId)
model FiscalIcmsApuration {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// 🆕 Sprint 8: cliente dono da apuração
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  year        Int
  month       Int                          /// 1-12

  /// Créditos (automáticos das NF-e de entrada)
  creditsIcms   Decimal @default(0) @db.Decimal(12, 2)
  creditsIcmsSt Decimal @default(0) @db.Decimal(12, 2)
  purchasesValue Decimal @default(0) @db.Decimal(12, 2)
  invoicesCount  Int     @default(0)

  /// Débitos (manuais: vendas × alíquota)
  salesValue  Decimal @default(0) @db.Decimal(12, 2)
  debitRate   Decimal @default(0) @db.Decimal(5, 2)
  debitsIcms  Decimal @default(0) @db.Decimal(12, 2)

  /// Resultado: positivo = a pagar | negativo = crédito acumulado
  balance     Decimal @default(0) @db.Decimal(12, 2)

  status      String   @default("ABERTA")  /// ABERTA | FECHADA
  closedAt    DateTime?
  observations String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, clientId, year, month])  // 🆕 unique inclui clientId
  @@index([companyId, clientId, year])          // 🆕 índice
  @@index([companyId, year])
  @@map("fiscal_icms_apurations")
}
// =================================================================
// 📥 NFS-e — NOTA FISCAL DE SERVIÇOS (FD-3a)
// =================================================================
// Serviços ≠ mercadorias: NFS-e gera ISS + receita de serviço.
// Foco inicial: EMITIDAS (cliente prestou o serviço).
// Padrão: ABRASF 2.0 com adaptadores por município (ADR-036).
// Origem (source) é atributo, não arquitetura: MANUAL hoje,
// EMAIL/PORTAL/OCR amanhã despejam na mesma fila (ADR-037).
// =================================================================

enum NfseDirection {
  EMITIDA    /// Cliente prestou o serviço (receita + ISS a pagar)
  RECEBIDA   /// Cliente contratou serviço (despesa)
}

enum NfseStatus {
  IMPORTED   /// Importada, aguardando revisão
  REVIEW     /// Na fila 🟡 (divergência ou campo não reconhecido)
  ACCOUNTED  /// Promovida ao contábil/financeiro
  REJECTED   /// Rejeitada pelo humano
}

/// NFS-e processada (1 por emissor + número + série)
model FiscalServiceInvoice {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Cliente dono do documento (null = não vinculado ainda)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // ── Identificação da NFS-e ─────────────────────────────────────
  number           String             /// Número na prefeitura
  series           String   @default("")
  verificationCode String?            /// Código de verificação (autenticidade)
  emissionDate     DateTime
  competenceDate   DateTime?          /// Competência do ISS

  // ── Partes ─────────────────────────────────────────────────────
  issuerCnpj String                  /// Prestador do serviço
  issuerName String
  takerCnpj  String?                  /// Tomador do serviço
  takerName  String?

  // ── Valores ────────────────────────────────────────────────────
  serviceValue Decimal  @db.Decimal(12, 2)  /// Valor do serviço
  deductions   Decimal  @default(0) @db.Decimal(12, 2)
  issBase      Decimal  @default(0) @db.Decimal(12, 2)
  issRate      Decimal  @default(0) @db.Decimal(5, 2)  /// % (ex: 3.5)
  issValue     Decimal  @default(0) @db.Decimal(12, 2)
  issRetained  Boolean  @default(false)     /// ISS retido pelo tomador?

  // ── Serviço ────────────────────────────────────────────────────
  serviceCode        String?  /// Código LC 116/03 (ex: "01.01")
  serviceDescription String?  @db.Text
  municipalityCode   String?  /// IBGE do município de prestação

  // ── Processamento (Pilar B: nunca descarta) ───────────────────
  direction NfseDirection @default(EMITIDA)
  source    String        @default("MANUAL") /// MANUAL | EMAIL | PORTAL | OCR
  status    NfseStatus    @default(IMPORTED)
  rawXml    String?       @db.Text           /// XML original p/ auditoria/reparse

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, issuerCnpj, number, series])  /// idempotência: 2× não duplica
  @@index([companyId, clientId])
  @@index([companyId, status])
  @@index([companyId, emissionDate])
  @@map("fiscal_service_invoices")
}

// =================================================================
// 🏦 MÓDULO BANCÁRIO — Fechamento Mensal (Sprint 21)
// =================================================================
// Extratos importados (CSV), classificação por natureza e memória
// de aprendizado (regras). Multi-tenant + multi-cliente.

/// Importação mensal do extrato (1 por cliente/mês/ano)
model BankStatement {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  year      Int
  month     Int      /// 1-12
  fileName  String?
  status    String   @default("ABERTO") /// ABERTO | FECHADO

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions BankTransaction[]

  @@unique([companyId, clientId, year, month])
  @@index([companyId, clientId])
  @@map("bank_statements")
}

/// Cada linha do extrato (débito/crédito) classificada
model BankTransaction {
  id          String        @id @default(cuid())
  statementId String
  statement   BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  companyId   String

  date        DateTime
  description String        /// Texto original do banco
  counterparty String?      /// Nome extraído (após o "-")
  amount      Decimal       @db.Decimal(12, 2) /// + crédito / - débito
  matches           BankNfeMatch[]
  nature       String       @default("NAO_CLASSIFICADO") // 🆕 Sprint 24: categoria livre por cliente
  classifiedBy String?      /// AUTO | MANUAL

  createdAt DateTime @default(now())

  @@index([statementId])
  @@index([companyId, nature])
  @@map("bank_transactions")
}

/// Memória de classificação: aprende com as revisões do contador
model BankClassificationRule {
  id        String     @id @default(cuid())
  companyId String
  pattern   String     /// Texto normalizado p/ casar (ex: "CEEE")
  nature    String
  hits      Int        @default(0) /// quantas vezes foi usada
  createdAt DateTime   @default(now())

  @@unique([companyId, pattern])
  @@map("bank_classification_rules")
}

/// 🆕 Sprint 24: categorias personalizadas por cliente (naturezas do extrato)
model BankCategory {
  id        String   @id @default(cuid())
  companyId String
  clientId  String?  /// null = modelo geral do escritório
  label     String   /// "Mensalidades", "Energia", "Cartões"...
  group     String   /// RECEITA | FINANCEIRA | DESPESA | IMPOSTO | SOCIO | PENDENTE
  isSystem  Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([companyId, clientId, label])
  @@index([companyId, clientId])
  @@map("bank_categories")
}

// =================================================================
// 🆕 SPRINT 29: CONCILIAÇÃO BANCO × NF-e
// =================================================================

enum MatchStatus {
  SUGESTAO    /// Sugestão do motor (aguardando confirmação)
  CONFIRMADO  /// Confirmado pelo usuário
  DESCARTADO  /// Descartado pelo usuário
}

enum MatchType {
  AUTO   /// Matching automático pelo motor
  MANUAL /// Criado manualmente pelo usuário
}

model BankNfeMatch {
  id                String      @id @default(cuid())
  companyId         String      /// Multi-tenant
  
  bankTransactionId String
  bankTransaction   BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)
  
  fiscalInvoiceId   String
  fiscalInvoice     FiscalInvoice @relation(fields: [fiscalInvoiceId], references: [id], onDelete: Cascade)
  
  score             Float       /// 0–100 (confiança do match)
  matchType         MatchType   @default(AUTO)
  status            MatchStatus @default(SUGESTAO)
  
  scoreBreakdown    Json?       /// {valor: 60, nome: 30, data: 10}
  
  confirmedAt       DateTime?
  confirmedBy       String?     /// userId que confirmou
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  @@unique([bankTransactionId, fiscalInvoiceId])
  @@index([companyId, status])
  @@map("bank_nfe_matches")
}

// Adicionar relation em BankTransaction (localize o model BankTransaction e adicione):
// matches           BankNfeMatch[]

// Adicionar relation em FiscalInvoice (localize o model FiscalInvoice e adicione):
// bankMatches       BankNfeMatch[]

// =================================================================
// 🤖 MÓDULO FUNCIONÁRIO DIGITAL — AURORA (Sprint FD-1 — Fundação)
// =================================================================
// Aurora é a funcionária digital do Radar: roda automações
// agendadas (conciliação, classificação, lançamentos) e entrega
// tudo pronto para revisão humana.
//
// ADR-025: Playwright em worker separado (futuro FD-7)
// ADR-030: Regra de Ouro (ações LEGAL nunca AUTO)
// ADR-031: Cálculo tributário determinístico (IA só sugere)
// ADR-032: LGPD + cofres criptografados
// ADR-033: Perfis de aprovação (Auxiliar confere, Contador aprova)
// =================================================================

// ─────────────────────────────────────────────────────────────────
// STATUS DA AURORA (1 por escritório)
// ─────────────────────────────────────────────────────────────────
enum RobotWorkerStatus {
  ACTIVE    /// Trabalhando normalmente
  PAUSED    /// Em pausa ("férias" — não executa agendamentos)
}
// =================================================================
// 🧾 GUIAS DE IMPOSTO (FD-4)
// =================================================================
// Cada linha é uma guia calculada pela Aurora para 1 cliente/mês/tipo.
// ADR-020: valores sempre round2 (sem erro de ponto flutuante).
// ADR-038: memory JSON preserva CADA passo do cálculo p/ auditoria
//          (contador vê a conta, não só o resultado).
// =================================================================

enum TaxGuideType {
  DAS         /// Simples Nacional (LC 123/2006)
  ISS         /// Imposto Sobre Serviços (LC 116/2003)
  DARF        /// Tributo federal retido (futuro)
}

enum TaxGuideStatus {
  DRAFT       /// Calculada, aguardando conferência humana
  APPROVED    /// Humano conferiu e aprovou
  TRANSMITTED /// Transmitida ao portal oficial (registro manual)
  REJECTED    /// Humano rejeitou o cálculo
}
/// Guia de imposto calculada pela Aurora (FD-4)
model TaxGuide {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Período de apuração (YYYY-MM) — ex: "2026-07"
  period    String

  type      TaxGuideType

  /// Valor da guia (R$) — sempre round2
  value     Decimal  @db.Decimal(12, 2)

  /// Vencimento da guia (data-limite p/ recolhimento)
  dueDate   DateTime?

  status    TaxGuideStatus  @default(DRAFT)

  /// MEMÓRIA DE CÁLCULO (ADR-038) — preserva tudo:
  ///   { steps: string[], sources: string[], lawRef: string,
  ///     rbt12?, bracketIndex?, nominalRate?, effectiveRate?, ... }
  memory    Json     @default("{}")

  /// Run de auditoria que gerou esta guia
  runId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, clientId, period, type])   /// idempotência
  @@index([companyId, period])
  @@index([companyId, status])
  @@index([companyId, type])
  @@map("tax_guides")
}

// ─────────────────────────────────────────────────────────────────
// CATÁLOGO DE SKILLS (o que a Aurora sabe fazer)
// ─────────────────────────────────────────────────────────────────
enum SkillKey {
  RECONCILIATION     /// Conciliação Banco × NF-e (FD-2)
  CLASSIFICATION     /// Classificação c/ memória (FD-2)
  ACCOUNTING_BRIDGE  /// Ponte Bancário → Contábil (FD-2)
  MONTHLY_REPORT     /// Relatório PDF mensal (FD-2)
  TAX_GUIDES         /// Emissão de DAS/ISS/DARF (FD-4) — futuro
  NFSE_IMPORT        /// Importação NFS-e (FD-3) — futuro
  BILLING            /// CNAB remessa/retorno (FD-5) — futuro
  OBLIGATIONS        /// SPED/obrigações (FD-6) — futuro
}

// ─────────────────────────────────────────────────────────────────
// NÍVEL DE AUTONOMIA (Pilar A — ADR-030)
// ─────────────────────────────────────────────────────────────────
enum AutonomyLevel {
  AUTO       /// Executa sozinho (score ≥80%)
  REVIEW     /// Fila de revisão (score 50–79% ou riskLevel=LEGAL)
  MANUAL     /// Só sugere, humano sempre decide
}

// ─────────────────────────────────────────────────────────────────
// STATUS DA EXECUÇÃO (o "ponto" da Aurora)
// ─────────────────────────────────────────────────────────────────
enum RunStatus {
  RUNNING    /// Executando agora
  SUCCESS    /// Terminou tudo certo
  PARTIAL    /// Terminou com pendências (parte foi pra fila)
  FAILED     /// Erro catastrófico (ver errorMessage)
  CANCELLED  /// Cancelado pelo usuário
}

// ─────────────────────────────────────────────────────────────────
// STATUS DA PENDÊNCIA (fila de revisão)
// ─────────────────────────────────────────────────────────────────
enum PendingStatus {
  PENDING    /// Aguardando decisão humana
  APPROVED   /// Aprovado pelo humano
  REJECTED   /// Rejeitado pelo humano
  EXPIRED    /// Expirou sem resposta (30 dias)
}

// ─────────────────────────────────────────────────────────────────
// DECISÃO HUMANA (ApprovalRecord)
// ─────────────────────────────────────────────────────────────────
enum ApprovalDecision {
  APPROVED   /// Aprovado
  REJECTED   /// Rejeitado
}

// ─────────────────────────────────────────────────────────────────
// 🤖 A AURORA (1 instância por tenant/escritório)
// ─────────────────────────────────────────────────────────────────
/// Representa a funcionária digital do escritório.
/// É criada automaticamente no primeiro acesso (lazy).
/// companyId único = ADR-004 (multi-tenant single-database).
model RobotWorker {
  id        String            @id @default(cuid())
  companyId String            @unique
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name      String            @default("Aurora")
  avatar    String            @default("🌅")       /// Emoji do avatar
  status    RobotWorkerStatus @default(ACTIVE)

  /// JSON com configurações globais da Aurora (ex.: timezone, idioma)
  config    Json              @default("{}")

  skills    RobotWorkerSkill[]
  runs      AutomationRun[]

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@map("robot_workers")
}

// ─────────────────────────────────────────────────────────────────
// 🧩 SKILL DA AURORA (1 por tipo, com cron individual)
// ─────────────────────────────────────────────────────────────────
/// Cada habilidade pode ser ligada/desligada e tem seu próprio cron.
/// cronExpr usa formato POSIX cron (ex.: "0 2 * * *" = todo dia 02:00).
/// riskLevel=LEGAL força REVIEW independente do score (Regra de Ouro).
model RobotWorkerSkill {
  id          String         @id @default(cuid())
  companyId   String
  workerId    String
  worker      RobotWorker    @relation(fields: [workerId], references: [id], onDelete: Cascade)

  skillKey    SkillKey
  enabled     Boolean        @default(false)       /// Liga/desliga pelo painel
  cronExpr    String         @default("0 2 * * *") /// Cron POSIX
  autonomy    AutonomyLevel  @default(REVIEW)      /// ADR-030

  /// Parâmetros específicos da skill (ex.: clientId-alvo, tolerâncias)
  params      Json           @default("{}")

  lastRunAt   DateTime?
  lastRunId   String?        /// ID do último AutomationRun

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([companyId, skillKey])   /// 1 skill por tenant por tipo
  @@index([companyId, enabled])
  @@map("robot_worker_skills")
}

// ─────────────────────────────────────────────────────────────────
// 📋 EXECUÇÃO (o "ponto" da Aurora)
// ─────────────────────────────────────────────────────────────────
/// Cada vez que uma skill é executada (cron ou botão manual),
/// uma linha é criada aqui. É a prova do que a Aurora fez.
model AutomationRun {
  id                String      @id @default(cuid())
  companyId         String
  workerId          String
  worker            RobotWorker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  skillKey          SkillKey
  triggerType       String      @default("CRON")    /// CRON | MANUAL | WEBHOOK
  triggeredBy       String?     /// userId (se manual) ou "SYSTEM"

  status            RunStatus   @default(RUNNING)

  startedAt         DateTime    @default(now())
  finishedAt        DateTime?

  /// Métricas da execução (o que o dashboard exibe)
  itemsProcessed    Int         @default(0)
  itemsAutoApproved Int         @default(0)         /// score ≥80%
  itemsPendingHuman Int         @default(0)         /// 50–79% → fila
  itemsFailed       Int         @default(0)
  secondsSaved      Int         @default(0)         /// métrica de marketing

  errorMessage      String?     @db.Text

  pendings          AutomationPending[]
  monthlyReports    MonthlyReport[]   // 🆕 FD-2 final: relatórios gerados por este run

  @@index([companyId, startedAt])
  @@index([companyId, status])
  @@index([workerId])
  @@map("automation_runs")
}

// ─────────────────────────────────────────────────────────────────
// 🟡 FILA DE REVISÃO (human-in-the-loop — Pilar B)
// ─────────────────────────────────────────────────────────────────
/// Itens que a Aurora não teve confiança suficiente para decidir
/// sozinha. O contador revisa, aprova ou rejeita.
/// type = MATCH | CLASSIFICATION | DIVERGENCE | GUIDE_REVIEW etc.
/// payload = JSON com os dados específicos (ids, scores, sugestões).
model AutomationPending {
  id         String        @id @default(cuid())
  companyId  String
  runId      String?
  run        AutomationRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  type       String                                  /// MATCH, CLASSIFICATION, etc.
  confidence Float?                                  /// 0–100 (score da sugestão)

  /// JSON com os dados da pendência (ex.: {bankTxId, invoiceId, breakdown})
  payload    Json

  status     PendingStatus @default(PENDING)
  resolvedBy String?       /// userId que resolveu
  resolvedAt DateTime?
  notes      String?       @db.Text

  createdAt  DateTime      @default(now())

  @@index([companyId, status])
  @@index([companyId, type])
  @@index([runId])
  @@map("automation_pendings")
}

// ─────────────────────────────────────────────────────────────────
// 📝 TRILHA DE AUDITORIA (compliance contábil — Pilar D)
// ─────────────────────────────────────────────────────────────────
/// 100% das ações da Aurora (e do humano revisando) ficam aqui.
/// É o "histórico de trabalho" auditável — exigência fiscal.
model AutomationAudit {
  id           String   @id @default(cuid())
  companyId    String

  actor        String   @default("AURORA")           /// AURORA | USER_<id>
  action       String                                /// AUTO_RECONCILED, USER_APPROVED...

  entity       String                                /// BankNfeMatch, AccountingEntry...
  entityId     String                                /// ID da entidade afetada

  /// Snapshot antes/depois + score + breakdown (JSON)
  detail       Json?

  robotVersion String?                               /// Versão da Aurora (ex.: "1.0.0")
  ip           String?                               /// IP de origem (se humano)

  createdAt    DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, entity, entityId])
  @@map("automation_audits")
}

// ─────────────────────────────────────────────────────────────────
// ✅ APROVAÇÃO HUMANA (trava de transmissão — Regra de Ouro)
// ─────────────────────────────────────────────────────────────────
/// Nada que gere obrigação legal, pagamento ou transmissão oficial
/// sai sem um ApprovalRecord vinculado. Isso é nossa proteção jurídica.
/// entityType = GUIDE | SPED | RECONCILIATION | NFSE_BATCH | PAYROLL
model ApprovalRecord {
  id         String   @id @default(cuid())
  companyId  String

  entityType String
  entityId   String

  decision   ApprovalDecision
  decidedBy  String                                  /// userId
  decidedAt  DateTime @default(now())
  ip         String?
  notes      String?  @db.Text

  @@index([companyId, entityType, entityId])
  @@map("approval_records")
}
// =================================================================
// 📊 RELATÓRIOS MENSAIS (MonthlyReportSkill — FD-2 final)
// =================================================================
// PDF mensal gerado pela Aurora para cada cliente ativo.
// Contém: resumo financeiro, métricas do mês, atividades da Aurora.
// Arquivo físico em: backend/uploads/reports/{companyId}/{YYYY-MM}/{clientId}.pdf
// =================================================================

/// Status de geração do relatório
enum ReportStatus {
  GENERATING   /// Em produção
  READY        /// Pronto para download
  FAILED       /// Falhou (ver errorMessage)
}

/// Registro de um relatório mensal gerado (1 por cliente/mês)
model MonthlyReport {
  id          String        @id @default(cuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Período do relatório (ex.: "2026-07")
  period      String

  /// Caminho relativo do PDF (a partir de backend/uploads/)
  pdfPath     String?

  /// Resumo em JSON (total honorários, transações, tempo economizado, etc.)
  summary     Json?

  status      ReportStatus  @default(GENERATING)
  errorMessage String?      @db.Text

  /// Vínculo com o AutomationRun que gerou (opcional — geração manual não tem run)
  runId       String?
  run         AutomationRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  /// Quem gerou (userId se manual, null se cron)
  generatedBy String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([companyId, clientId, period])  /// 1 relatório por cliente/mês/tenant
  @@index([companyId, period])
  @@index([clientId])
  @@map("monthly_reports")
}