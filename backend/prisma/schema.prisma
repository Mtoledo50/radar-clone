// =================================================================
// RADAR CONTA CERTA - SCHEMA ENTERPRISE (SaaS Multi-Tenant)
// =================================================================
// Autor: Arquitetura de Software Sênior
// Descrição: Modelagem de dados robusta para SaaS Contábil
// Sprint 8: Adicionado clientId nos modelos fiscais para vínculo
//           do estoque por cliente (multi-cliente por escritório)
// =================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =================================================================
// 🔠 ENUMS (Tipagem Forte e Regras de Negócio)
// =================================================================

enum UserRole {
  SUPER_ADMIN /// Administrador do Sistema (Plataforma)
  ADMIN       /// Administrador do Escritório (Tenant)
  MANAGER     /// Gerente de Setor
  USER        /// Colaborador Padrão
  CLIENTE     /// Acesso do Cliente (Portal)
}

enum EmployeeStatus {
  ACTIVE    /// Ativo
  INACTIVE  /// Inativo / Férias
  DISMISSED /// Desligado
}

enum ClientStatus {
  ATIVO     /// Cliente ativo e pagante
  PROSPECT  /// Em negociação (Lead)
  INATIVO   /// Pausado temporariamente
  CHURN     /// Perdido / Cancelado
  SUSPENSO  /// Inadimplente / Suspenso
}

enum ServiceType {
  CONTABIL    /// Contábil
  FISCAL      /// Fiscal
  PESSOAL     /// Departamento Pessoal
  MEI         /// MEI
  IRPF        /// Imposto de Renda Pessoa Física
  CONSULTORIA /// Consultoria
  OUTROS      /// Outros
}

enum Complexity {
  BAIXA
  MEDIA
  ALTA
}

enum PricingStatus {
  RASCUNHO
  APROVADO
  REJEITADO
}

enum PlanningStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum TransactionType {
  RECEITA
  DESPESA
}

enum AccountType {
  ATIVO
  PASSIVO
  PATRIMONIO_LIQUIDO
  RECEITA
  DESPESA
}

enum AccountNature {
  DEVEDORA
  CREDORA
}

enum ProposalStatus {
  DRAFT       /// Rascunho
  SENT        /// Enviada ao cliente
  VIEWED      /// Visualizada
  CLOSED_WON  /// Fechada (Ganha)
  CLOSED_LOST /// Perdida
}

enum Recurrence {
  AVULSO      /// Pagamento único (ex: IRPF, Abertura)
  MENSAL      /// Recorrência mensal (ex: Honorários)
  TRIMESTRAL  /// Recorrência trimestral
  ANUAL       /// Recorrência anual (ex: DASN, Balanço)
}

// =================================================================
// 🏢 EMPRESA (TENANT / MULTI-TENANT)
// =================================================================
/// Representa o escritório contábil (Tenant). 
/// Todos os dados do sistema são isolados por companyId.
model Company {
  id                String   @id @default(uuid())
  name              String   
  cnpj              String?  @unique
  state             String?
  
  email             String?
  phone             String?
  address           String?
  logoUrl           String?
  softwareStack     String[] @default([])
  businessGoals     String?  @db.Text
  
  /// Plano de assinatura do próprio escritório na plataforma Radar
  plan              String   @default("BASIC") 
  allowedModules    String[] @default(["dashboard", "pessoas", "clientes"]) 
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?
  
  users             User[]
  turnoverDistributions TurnoverSectorDistribution[] 
  
  // Catálogo de Serviços
  serviceCategories ServiceCategory[]
  serviceItems      ServiceItem[]
  commercialPlans   CommercialPlan[]
  
  // Precificação
  pricingConfigs      PricingConfig?
  pricingHourRules    PricingHourRule[]
  pricingCalculations PricingCalculation[]
  
  // Comercial
  proposals           Proposal[]
  
  // BI e Métricas
  clientMonthlyData   ClientMonthlyData[]
  
  // Planejamento Estratégico
  planningCycles      PlanningCycle[]
  planningAreas       PlanningArea[]
  planningObjectives  PlanningObjective[]
  planningGoals       PlanningGoal[]
  planningKpis        PlanningKPI[]
  actionPlans         ActionPlan[]

  // Contábil
  accountingAccounts  AccountingAccount[]
  accountingEntries   AccountingEntry[]
  
  // Contratos
  clientContracts     ClientContract[]
  clientServices      ClientService[]

  // Projetos e Tarefas
  projects        Project[]
  tasks           Task[]

   // 📦 Módulo Fiscal
  fiscalSuppliers       FiscalSupplier[]
  fiscalProducts        FiscalProduct[]
  fiscalInvoices        FiscalInvoice[]
  fiscalMovements       FiscalInventoryMovement[]
  fiscalBalances        FiscalInventoryBalance[]
  fiscalApurations    FiscalIcmsApuration[]
  bankStatements      BankStatement[]
  fiscalServiceInvoices FiscalServiceInvoice[]   // 🆕 FD-3a
  taxGuides           TaxGuide[]                 // 🆕 FD-4


  // 🤖 Funcionário Digital (FD-1)
  robotWorker       RobotWorker?
    // 📊 Relatórios Mensais (FD-2 final)
  monthlyReports  MonthlyReport[]
  @@map("companies")
}

// =================================================================
// 👤 USUÁRIO
// =================================================================
model User {
  id                    String                @id @default(uuid())
  name                  String
  email                 String                @unique
  password              String
  role                  UserRole              @default(USER) 
  companyId             String
  company               Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?

  companyProfile        CompanyProfile?
  employees             Employee[]
  clients               Client[]
  pricings              Pricing[]
  plannings             Planning[]
  financialTransactions FinancialTransaction[]
  turnoverMonthly       TurnoverMonthly[]
  sectors               Sector[]
  dismissalReasons      DismissalReason[]
  positions             Position[]
  resignations          Resignation[]
  turnoverDistributions TurnoverSectorDistribution[] 
  
  pricingCalculations   PricingCalculation[]
  proposals             Proposal[]
  clientMonthlyData     ClientMonthlyData[]

  // Tarefas atribuídas
assignedTasks   Task[]
  
  @@index([companyId])
  @@map("users")
}

// =================================================================
// 📊 PERFIL DA EMPRESA (ONBOARDING)
// =================================================================
model CompanyProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  razaoSocial         String?
  cnpj                String?
  estado              String?
  
  softwareConsultoria Boolean  @default(false)
  softwareContabil    Boolean  @default(false)
  softwareFiscal      Boolean  @default(false)
  
  clientesHoje        Int      @default(0)
  clientesAno         Int      @default(0)
  funcionariosHoje    Int      @default(0)
  funcionariosAno     Int      @default(0)
  visaoEmpresa        String?
  maiorDesafio        String?
  compromisso         String?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("company_profiles")
}

// =================================================================
// 👷 COLABORADOR
// =================================================================
model Employee {
  id              String         @id @default(uuid())
  userId          String
  companyId       String   
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name            String
  email           String?
  phone           String?
  position        String
  department      String?
  admissionDate   DateTime
  dismissalDate   DateTime?
  salary          Float?
  status          EmployeeStatus @default(ACTIVE)
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  @@index([userId])
  @@index([companyId])
  @@map("employees")
}

// =================================================================
// 🏢 CLIENTE
// =================================================================
model Client {
  id                    String                @id @default(uuid())
  userId                String
  companyId             String                
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  companyName           String
  cnpj                  String?
  serviceType           ServiceType           @default(CONTABIL)
  monthlyFee            Float                 /// Honorário atual (snapshot)
  status                ClientStatus          @default(ATIVO)
  
  startDate             DateTime
  endDate               DateTime?
  
  contactName           String?
  contactEmail          String?
  contactPhone          String?
  
    observations          String?               @db.Text

  // 🆕 Sprint 23: dados contratuais importados (planilha de honorários)
  lastPaymentDate       DateTime?
  installments          Int?
  openAmount            Float?
  paidAmount            Float?
  overdueAmount         Float?
  
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?
  
  financialTransactions FinancialTransaction[]
  accountingEntries     AccountingEntry[]     
  
  // Relações Contratuais
  contracts             ClientContract[]
  services              ClientService[]
  
  // Projetos e Tarefas
  projects              Project[]
  tasks                 Task[]

  // 📦 Sprint 8: Vínculo do Estoque Fiscal ao Cliente
  fiscalProducts        FiscalProduct[]
  fiscalInvoices        FiscalInvoice[]
  fiscalMovements       FiscalInventoryMovement[]
  fiscalApurations      FiscalIcmsApuration[]
  bankStatements        BankStatement[]
  // 📊 Relatórios mensais do cliente
  monthlyReports  MonthlyReport[]
  fiscalServiceInvoices FiscalServiceInvoice[]   // 🆕 FD-3a
  taxGuides           TaxGuide[]                 // 🆕 FD-4

  @@index([userId])
  @@unique([companyId, companyName])  // 🆕 FD-2: upsert seguro por (tenant + nome)
  @@map("clients")
}

// =================================================================
// 📦 CATÁLOGO DE SERVIÇOS (O CORAÇÃO DO SaaS)
// =================================================================

/// Categorias de Serviços (Ex: Fiscal, DP, Contábil, MEI)
model ServiceCategory {
  id          String        @id @default(uuid())
  companyId   String
  name        String
  icon        String?
  order       Int           @default(0)
  description String?
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items       ServiceItem[]
  
  @@index([companyId])
  @@map("service_categories")
}

/// Item de Serviço (O que é vendido)
model ServiceItem {
  id          String            @id @default(uuid())
  companyId   String
  categoryId  String
  
  name        String            /// Ex: "Declaração Anual DASN-SIMEI"
  description String?           /// Descrição curta para o cliente
  
  /// Escopo detalhado (O que está incluso)
  scope       String?           @db.Text
  /// O que NÃO está incluso (Gera cobrança extra)
  outOfScope  String?           @db.Text
  /// Documentos que o cliente precisa enviar
  requiredDocs String?          @db.Text
  
  basePrice   Decimal           @db.Decimal(10, 2) /// Valor de tabela
  estimatedHours Float          /// Horas estimadas para precificação
  slaDays     Int               @default(5)        /// Prazo de entrega em dias
  
  recurrence  Recurrence        @default(MENSAL)
  
  order       Int               @default(0)
  isActive    Boolean           @default(true)
  
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    ServiceCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  planItems   PlanServiceItem[]
  proposalItems ProposalItem[]
  clientServices ClientService[]
  
  @@index([companyId])
  @@index([categoryId])
  @@map("service_items")
}

// =================================================================
// 💼 PLANOS COMERCIAIS (PACOTES)
// =================================================================

/// Plano Comercial (Ex: Plano MEI Essencial, Plano Lucro Presumido)
model CommercialPlan {
  id            String            @id @default(uuid())
  companyId     String
  name          String
  multiplier    Float             @default(1.0) /// Multiplicador sobre o custo base
  order         Int               @default(0)
  isIndependent Boolean           @default(false)
  color         String?
  badge         String?
  description   String?           @db.Text
  
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
  
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planItems     PlanServiceItem[]
  contracts     ClientContract[]
  proposalItems ProposalItem[]
  
  @@index([companyId])
  @@map("commercial_plans")
}

/// Vínculo N:N entre Plano e Itens de Serviço
model PlanServiceItem {
  id            String        @id @default(uuid())
  planId        String
  serviceItemId String
  
  quantity      Int           @default(1)
  discount      Float         @default(0)
  
  createdAt     DateTime      @default(now())
  
  plan          CommercialPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  serviceItem   ServiceItem    @relation(fields: [serviceItemId], references: [id], onDelete: Cascade)
  
  @@unique([planId, serviceItemId])
  @@index([planId])
  @@index([serviceItemId])
  @@map("plan_service_items")
}

// =================================================================
// 📝 CONTRATO DO CLIENTE (HISTÓRICO E VIGÊNCIA)
// =================================================================

/// Contrato vinculando o Cliente a um Plano Comercial
model ClientContract {
  id                String   @id @default(uuid())
  companyId         String
  clientId          String
  commercialPlanId  String
  
  startDate         DateTime
  endDate           DateTime?
  
  monthlyFee        Decimal  @db.Decimal(10, 2)
  status            String   @default("ATIVO") /// ATIVO, SUSPENSO, CANCELADO
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client            Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  commercialPlan    CommercialPlan @relation(fields: [commercialPlanId], references: [id], onDelete: Restrict)
  
  @@index([companyId])
  @@index([clientId])
  @@map("client_contracts")
}

/// Serviços Avulsos ou Recorrentes contratados FORA do plano principal
model ClientService {
  id              String     @id @default(uuid())
  companyId       String
  clientId        String
  serviceItemId   String
  
  //customPrice     Decimal?   @db.Decimal(10, 2)
  recurrence      Recurrence
  status          String     @default("ATIVO")
  
  startDate       DateTime
  endDate         DateTime?
  
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client          Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceItem     ServiceItem @relation(fields: [serviceItemId], references: [id], onDelete: Restrict)
  
  @@index([companyId])
  @@index([clientId])
  @@map("client_services")
}

// =================================================================
// 💰 PRECIFICAÇÃO E PROPOSTAS
// =================================================================

/// Cálculo de Precificação (Rascunho/Simulação)
model PricingCalculation {
  id                String   @id @default(uuid())
  companyId         String
  userId            String
  
  proposalNumber    String?
  clientName        String
  
  taxRegime         String
  annex             String?
  activity          String
  monthlyRevenue    Float
  employeeCount     Int
  dpMethod          String   @default("MARGIN")
  dpValue           Float    @default(0)
  hasBranches       Boolean  @default(false)
  hasErp            Boolean  @default(false)
  
  hoursFiscal       Float    @default(0)
  hoursAccounting   Float    @default(0)
  costPerHour       Float    @default(0)
  basePrice         Float    @default(0)
  currentCharge     Float?
  
  planPrices        Json?
  
  status            String   @default("DRAFT")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([companyId])
  @@index([status])
  @@map("pricing_calculations")
}

/// Proposta Comercial Enviada ao Cliente
model Proposal {
  id                String         @id @default(uuid())
  companyId         String
  userId            String
  
  proposalNumber    String         @unique
  slug              String         @unique
  clientName        String
  clientCnpj        String?
  
  taxRegime         String
  activity          String
  monthlyRevenue    Float
  employeeCount     Int
  basePrice         Float
  
  // TEXTOS DA PROPOSTA
  aboutOffice       String?        @db.Text
  differentials     String?        @db.Text
  onboarding        String?        @db.Text
  commercialTerms   String?        @db.Text
  specificNote      String?        @db.Text
  
  status            ProposalStatus @default(DRAFT)
  sentAt            DateTime?
  closedAt          DateTime?
  closedPlanId      String?
  closedPrice       Float?
  lossReason        String?
  
  views             Int            @default(0)
  whatsappClicks    Int            @default(0)
  
  // 🆕 SPRINT A3: Controle de Versões
  version           Int            @default(1)        // Número da versão (1, 2, 3...)
  isCurrent         Boolean        @default(true)     // true = versão ativa do cliente
  originalProposalId String?                          // ID da primeira versão da cadeia (para agrupar)
  originalProposal  Proposal?      @relation("ProposalVersions", fields: [originalProposalId], references: [id], onDelete: SetNull)
  versions          Proposal[]     @relation("ProposalVersions") // Outras versões desta proposta
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  items             ProposalItem[]
  
  @@index([companyId])
  @@index([userId])
  @@index([status])
  @@index([originalProposalId])
  @@index([isCurrent])
  @@map("proposals")
}
/// Itens dentro da Proposta (Substitui o JSON antigo)
model ProposalItem {
  id                String   @id @default(uuid())
  proposalId        String
  
  /// Pode ser um Plano inteiro ou um Serviço avulso
  commercialPlanId  String?
  serviceItemId     String?
  
  quantity          Int      @default(1)
  unitPrice         Decimal  @db.Decimal(10, 2)
  totalPrice        Decimal  @db.Decimal(10, 2)
  
  createdAt         DateTime @default(now())
  
  proposal          Proposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  commercialPlan    CommercialPlan? @relation(fields: [commercialPlanId], references: [id], onDelete: SetNull)
  serviceItem       ServiceItem?   @relation(fields: [serviceItemId], references: [id], onDelete: SetNull)
  
  @@index([proposalId])
  @@map("proposal_items")
}

// =================================================================
// 📊 DADOS MENSAIS DA CARTEIRA (BI / MRR / CHURN)
// =================================================================
model ClientMonthlyData {
  id              String   @id @default(uuid())
  companyId       String
  userId          String
  
  year            Int
  month           Int
  
  initialClients  Int      @default(0)
  newClients      Int      @default(0)
  churnedClients  Int      @default(0)
  finalClients    Int      @default(0)
  
  newRevenue      Float    @default(0)
  lostRevenue     Float    @default(0)
  finalRevenue    Float    @default(0)
  
  churnRate       Float    @default(0)
  accumulatedChurn Float   @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([companyId, year, month])
  @@index([companyId])
  @@index([userId])
  @@map("client_monthly_data")
}

// =================================================================
// 💸 FINANCEIRO E CONTÁBIL
// =================================================================
model FinancialTransaction {
  id          String          @id @default(uuid())
  userId      String
  companyId   String   
  clientId    String?
  
  type        TransactionType 
  category    String
  description String
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime        @default(now())
  
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  client      Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  
  @@index([companyId])
  @@index([userId, date])
  @@map("financial_transactions")
}

model AccountingEntry {
  id                  String   @id @default(uuid())
  companyId           String
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  entryDate           DateTime
  description         String
  documentNumber      String?
  counterpartyName    String?
  counterpartyCpfCnpj String?
  counterpartyType    String?
  
  clientId            String?
  bankTransactionId   String?   /// 🆕 Sprint 25.2: vínculo à transação bancária de origem
  client              Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  
  debitAccountId      String?
  debitAccount        AccountingAccount? @relation("DebitEntries", fields: [debitAccountId], references: [id])
  debitValue          Decimal  @default(0) @db.Decimal(12, 2)
  
  creditAccountId     String?
  creditAccount       AccountingAccount? @relation("CreditEntries", fields: [creditAccountId], references: [id])
  creditValue         Decimal  @default(0) @db.Decimal(12, 2)
  
  source              String   @default("MANUAL")
  status              String   @default("PENDENTE")
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([entryDate])
  @@map("accounting_entries")
}

model AccountingAccount {
  id          String          @id @default(uuid())
  companyId   String?         /// NULL = conta global/padrão do sistema
  code        String   
  name        String   
  type        AccountType   
  nature      AccountNature   
  level       Int             @default(1)
  parentId    String?
  isActive    Boolean         @default(true)
  sciCode     String?  
  reducedCode Int?   // ✅ código reduzido SCI p/ match + exportação

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  
  company     Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent      AccountingAccount? @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    AccountingAccount[] @relation("AccountHierarchy")
  debitEntries  AccountingEntry[] @relation("DebitEntries")
  creditEntries AccountingEntry[] @relation("CreditEntries")
   
  @@unique([companyId, code])  // 🔥 NOVA CONSTRAINT: Garante unicidade por empresa
  @@index([companyId])
  @@index([code])
  @@map("accounting_accounts")
}
// =================================================================
// 📋 TAREFAS E PROJETOS (Gestão Operacional)
// =================================================================

enum ProjectStatus {
  PLANNING    /// Planejamento
  ACTIVE      /// Ativo
  ON_HOLD     /// Pausado
  COMPLETED   /// Concluído
  CANCELLED   /// Cancelado
}

enum TaskStatus {
  BACKLOG       /// Backlog
  TODO          /// A fazer
  IN_PROGRESS   /// Em andamento
  REVIEW        /// Em revisão
  BLOCKED       /// Bloqueada
  DONE          /// Concluída
}

enum TaskPriority {
  LOW      /// Baixa
  MEDIUM   /// Média
  HIGH     /// Alta
  URGENT   /// Urgente
}

enum TaskCategory {
  FISCAL                /// Fiscal
  CONTABIL              /// Contábil
  DEPARTAMENTO_PESSOAL  /// Departamento Pessoal
  SOCIETARIO            /// Societário
  FINANCEIRO            /// Financeiro
  COMERCIAL             /// Comercial
  INTERNO               /// Interno
  OUTRO                 /// Outro
}

/// Projeto (conjunto de tarefas relacionadas)
model Project {
  id          String        @id @default(uuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  name        String
  description String?       @db.Text
  status      ProjectStatus @default(PLANNING)
  priority    TaskPriority  @default(MEDIUM)
  color       String?       /// Cor hexadecimal para identificação visual
  
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  
  clientId    String?
  client      Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  
  tasks       Task[]
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  
  @@index([companyId, status])
  @@index([companyId, deletedAt])
  @@map("projects")
}

/// Tarefa (unidade de trabalho)
model Task {
  id          String       @id @default(uuid())
  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  title       String
  description String?      @db.Text
  
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  category    TaskCategory @default(OUTRO)
  
  projectId   String?
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  
  clientId    String?
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  
  assigneeId  String?
  assignee    User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  
  startDate       DateTime?
  dueDate         DateTime?
  completedAt     DateTime?
  estimatedHours  Decimal?  @db.Decimal(8, 2)
  actualHours     Decimal?  @db.Decimal(8, 2)
  
  position    Int          @default(0) /// Ordem dentro do Kanban
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  
  @@index([companyId, status])
  @@index([companyId, priority])
  @@index([companyId, projectId])
  @@index([companyId, assigneeId])
  @@index([companyId, dueDate])
  @@index([companyId, deletedAt])
  @@map("tasks")
}

