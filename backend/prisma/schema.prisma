enum ProjectStatus {
  PLANNING    /// Planejamento
  ACTIVE      /// Ativo
  ON_HOLD     /// Pausado
  COMPLETED   /// ConcluÃ­do
  CANCELLED   /// Cancelado
}

enum TaskStatus {
  BACKLOG       /// Backlog
  TODO          /// A fazer
  IN_PROGRESS   /// Em andamento
  REVIEW        /// Em revisÃ£o
  BLOCKED       /// Bloqueada
  DONE          /// ConcluÃ­da
}

enum TaskPriority {
  LOW      /// Baixa
  MEDIUM   /// MÃ©dia
  HIGH     /// Alta
  URGENT   /// Urgente
}

enum TaskCategory {
  FISCAL                /// Fiscal
  CONTABIL              /// ContÃ¡bil
  DEPARTAMENTO_PESSOAL  /// Departamento Pessoal
  SOCIETARIO            /// SocietÃ¡rio
  FINANCEIRO            /// Financeiro
  COMERCIAL             /// Comercial
