// =================================================================
// ðŸ“¦ MÃ“DULO FISCAL â€” ESTOQUE E APURAÃ‡ÃƒO DE ICMS
// =================================================================
// Fase 1: Upload de XMLs, CatÃ¡logo de Produtos, Kardex de Entradas
// Multi-tenant: todos os modelos possuem companyId
// Sprint 8: VÃ­nculo por cliente (companyId + clientId)
// =================================================================

// -----------------------------------------------------------------
// ENUMS DO MÃ“DULO FISCAL
// -----------------------------------------------------------------

/// Tipo de documento fiscal processado
enum FiscalDocumentType {
  NFE_ENTRADA       /// NF-e de compra (entrada de mercadoria)
  NFE_DEVOLUCAO     /// NF-e de devoluÃ§Ã£o de compra
  CTE               /// CT-e (conhecimento de transporte) â€” futuro
}

/// Status de processamento do XML
enum InvoiceStatus {
  UPLOADED          /// Arquivo recebido, aguardando parser
  PARSING           /// Parser em execuÃ§Ã£o
  PARSED            /// Parser concluÃ­do com sucesso
  PARSE_ERROR       /// Falha no parser (XML invÃ¡lido ou incompleto)
  AWAITING_REVIEW   /// Aguardando revisÃ£o humana (produtos nÃ£o identificados)
  CONFIRMED         /// Confirmado e contabilizado no estoque
  CANCELLED         /// Cancelado pelo usuÃ¡rio
}

/// Tipo de movimentaÃ§Ã£o no Kardex
enum MovementType {
  ENTRADA           /// Entrada via NF-e de compra
  DEVOLUCAO         /// DevoluÃ§Ã£o de compra (reduz estoque)
  AJUSTE_POSITIVO   /// Ajuste manual de inventÃ¡rio (sobra)
  AJUSTE_NEGATIVO   /// Ajuste manual de inventÃ¡rio (quebra/perda)
  TRANSFERENCIA     /// TransferÃªncia entre filiais â€” futuro
  SALDO_INICIAL     /// ðŸ†• Sprint 10: saldo inicial importado (abertura do estoque)
}

/// Status de identificaÃ§Ã£o de produto (matching)
enum ProductMatchStatus {
  IDENTIFIED        /// Produto jÃ¡ cadastrado, match automÃ¡tico
  SUGGESTED         /// IA sugeriu match, aguardando confirmaÃ§Ã£o
  NEW               /// Produto novo, precisa ser cadastrado
}

// -----------------------------------------------------------------
// ðŸ¢ FORNECEDOR
// -----------------------------------------------------------------
/// Fornecedor da empresa (extraÃ­do automaticamente dos XMLs)
/// Unique por companyId + cnpj (mesmo fornecedor nÃ£o duplica)
model FiscalSupplier {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  cnpj              String              /// CNPJ do fornecedor (14 dÃ­gitos)
  name              String              /// RazÃ£o social
  tradeName         String?             /// Nome fantasia
  stateRegistration String?             /// InscriÃ§Ã£o estadual
  state             String?             /// UF (para regras de ST)
  email             String?
  phone             String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  invoices          FiscalInvoice[]

  @@unique([companyId, cnpj])
  @@index([companyId, name])
  @@map("fiscal_suppliers")
}

// -----------------------------------------------------------------
// ðŸ“¦ PRODUTO FISCAL (CatÃ¡logo)
// -----------------------------------------------------------------
/// Produto cadastrado no catÃ¡logo da empresa
/// Pode ser criado manualmente ou via parser de XML
/// ncm Ã© obrigatÃ³rio para apuraÃ§Ã£o de ICMS
/// Sprint 8: vÃ­nculo opcional a um cliente especÃ­fico (clientId)
/// Sprint 16: cÃ³digo opcional (nullable)
/// Sprint 19: unifiedCode (CÃ³digo Unificado da planilha)
model FiscalProduct {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// ðŸ†• Sprint 8: cliente dono do produto (pode ser null = genÃ©rico)
  clientId          String?
  client            Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  code              String?   /// CÃ³digo do produto (opcional - Sprint 16)
  unifiedCode       String?   /// ðŸ†• Sprint 19: CÃ³digo Unificado da planilha (coluna extra)
  ean               String?   /// CÃ³digo de barras (EAN-13)
  description       String    /// DescriÃ§Ã£o padronizada
  ncm               String    /// NCM (8 dÃ­gitos) â€” obrigatÃ³rio
  unit              String    /// Unidade de medida (UN, KG, L, CX, etc.)

  averageCost       Decimal  @default(0) @db.Decimal(12, 4)  /// Custo mÃ©dio atual
  currentStock      Decimal  @default(0) @db.Decimal(12, 4)  /// Saldo atual em estoque

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  invoiceItems      FiscalInvoiceItem[]
  movements         FiscalInventoryMovement[]
  balances          FiscalInventoryBalance[]

  @@unique([companyId, clientId, code])   // unique inclui clientId
  @@index([companyId, clientId])          // Ã­ndice para filtro por cliente
  @@index([companyId, ncm])
  @@index([companyId, description])
  @@map("fiscal_products")
}

// -----------------------------------------------------------------
// ðŸ“„ NOTA FISCAL DE ENTRADA (CabeÃ§alho)
// -----------------------------------------------------------------
/// Representa uma NF-e de entrada processada
/// accessKey Ã© a chave de 44 dÃ­gitos (Ãºnica por empresa)
/// Guarda os totais da nota e o caminho do XML original
/// Sprint 8: vÃ­nculo opcional a um cliente especÃ­fico (clientId)
model FiscalInvoice {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// ðŸ†• Sprint 8: cliente dono da nota (pode ser null = geral)
  clientId          String?
  client            Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  supplierId        String
  supplier          FiscalSupplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  documentType      FiscalDocumentType @default(NFE_ENTRADA)
  status            InvoiceStatus      @default(UPLOADED)

  number            String              /// NÃºmero da NF-e
  series            String              /// SÃ©rie da NF-e
  accessKey         String              /// Chave de acesso (44 dÃ­gitos)
  emissionDate      DateTime            /// Data de emissÃ£o
  entryDate         DateTime?           /// Data de entrada no sistema

  cfop              String?             /// CFOP principal da nota
  natOp             String?             /// Natureza da operaÃ§Ã£o

  totalValue        Decimal  @default(0) @db.Decimal(12, 2)
  discountValue     Decimal  @default(0) @db.Decimal(12, 2)
  freightValue      Decimal  @default(0) @db.Decimal(12, 2)
  insuranceValue    Decimal  @default(0) @db.Decimal(12, 2)
  otherValues       Decimal  @default(0) @db.Decimal(12, 2)

  icmsBase          Decimal  @default(0) @db.Decimal(12, 2)
  icmsValue         Decimal  @default(0) @db.Decimal(12, 2)
  icmsStValue       Decimal  @default(0) @db.Decimal(12, 2)
  ipiValue          Decimal  @default(0) @db.Decimal(12, 2)
  pisValue          Decimal  @default(0) @db.Decimal(12, 2)
  cofinsValue       Decimal  @default(0) @db.Decimal(12, 2)

  xmlOriginalUrl    String?             /// Caminho do XML original (S3 ou local)
  errorMessage      String?             /// Mensagem de erro (se status = PARSE_ERROR)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items             FiscalInvoiceItem[]
  // âœ… RelaÃ§Ã£o oposta com movimentos de estoque
  movements         FiscalInventoryMovement[]
  bankMatches       BankNfeMatch[]   // ðŸ†• ADICIONAR ESTA LINHA


  @@unique([companyId, accessKey])
  @@index([companyId, clientId])          // ðŸ†• Ã­ndice para filtro por cliente
  @@index([companyId, supplierId])
  @@index([companyId, emissionDate])
  @@index([companyId, status])
  @@map("fiscal_invoices")
}

// -----------------------------------------------------------------
// ðŸ“¦ ITENS DA NOTA FISCAL
// -----------------------------------------------------------------
/// Cada item (produto) dentro de uma NF-e
/// Guarda os impostos individuais por item (necessÃ¡rio para apuraÃ§Ã£o)
/// productMatchStatus indica se o produto foi identificado automaticamente
model FiscalInvoiceItem {
  id                String   @id @default(cuid())
  invoiceId         String
  invoice           FiscalInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId         String?
  product           FiscalProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  productMatchStatus ProductMatchStatus @default(NEW)

  itemNumber        Int                 /// NÃºmero do item na NF (1, 2, 3...)
  supplierCode      String?             /// CÃ³digo do produto no fornecedor
  description       String              /// DescriÃ§Ã£o do produto na NF

  ncm               String              /// NCM do item
  cfop              String              /// CFOP do item
  cst               String?             /// CST do ICMS (Lucro Presumido/Real)
  csosn             String?             /// CSOSN (Simples Nacional)

  quantity          Decimal  @db.Decimal(12, 4)
  unitValue         Decimal  @db.Decimal(12, 4)
  totalValue        Decimal  @db.Decimal(12, 2)
  discount          Decimal  @default(0) @db.Decimal(12, 2)

  icmsBase          Decimal  @default(0) @db.Decimal(12, 2)
  icmsRate          Decimal  @default(0) @db.Decimal(5, 2)
  icmsValue         Decimal  @default(0) @db.Decimal(12, 2)
  icmsStBase        Decimal  @default(0) @db.Decimal(12, 2)
  icmsStValue       Decimal  @default(0) @db.Decimal(12, 2)
  ipiBase           Decimal  @default(0) @db.Decimal(12, 2)
  ipiRate           Decimal  @default(0) @db.Decimal(5, 2)
  ipiValue          Decimal  @default(0) @db.Decimal(12, 2)
  pisBase           Decimal  @default(0) @db.Decimal(12, 2)
  pisRate           Decimal  @default(0) @db.Decimal(5, 2)
  pisValue          Decimal  @default(0) @db.Decimal(12, 2)
  cofinsBase        Decimal  @default(0) @db.Decimal(12, 2)
