// =================================================================
// RADAR CONTA CERTA - SCHEMA ENTERPRISE (SaaS Multi-Tenant)
// =================================================================
// Autor: Arquitetura de Software SÃªnior
// DescriÃ§Ã£o: Modelagem de dados robusta para SaaS ContÃ¡bil
// Sprint 8: Adicionado clientId nos modelos fiscais para vÃ­nculo
//           do estoque por cliente (multi-cliente por escritÃ³rio)
// =================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =================================================================
// ðŸ”  ENUMS (Tipagem Forte e Regras de NegÃ³cio)
// =================================================================

enum UserRole {
  SUPER_ADMIN /// Administrador do Sistema (Plataforma)
  ADMIN       /// Administrador do EscritÃ³rio (Tenant)
  MANAGER     /// Gerente de Setor
  USER        /// Colaborador PadrÃ£o
  CLIENTE     /// Acesso do Cliente (Portal)
}

enum EmployeeStatus {
  ACTIVE    /// Ativo
  INACTIVE  /// Inativo / FÃ©rias
  DISMISSED /// Desligado
}

enum ClientStatus {
  ATIVO     /// Cliente ativo e pagante
  PROSPECT  /// Em negociaÃ§Ã£o (Lead)
  INATIVO   /// Pausado temporariamente
  CHURN     /// Perdido / Cancelado
  SUSPENSO  /// Inadimplente / Suspenso
}

enum ServiceType {
  CONTABIL    /// ContÃ¡bil
  FISCAL      /// Fiscal
  PESSOAL     /// Departamento Pessoal
  MEI         /// MEI
  IRPF        /// Imposto de Renda Pessoa FÃ­sica
  CONSULTORIA /// Consultoria
  OUTROS      /// Outros
}

enum Complexity {
  BAIXA
  MEDIA
  ALTA
}

enum PricingStatus {
  RASCUNHO
  APROVADO
  REJEITADO
}

enum PlanningStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum TransactionType {
  RECEITA
  DESPESA
}

enum AccountType {
  ATIVO
  PASSIVO
  PATRIMONIO_LIQUIDO
  RECEITA
  DESPESA
}

enum AccountNature {
  DEVEDORA
  CREDORA
}

enum ProposalStatus {
  DRAFT       /// Rascunho
  SENT        /// Enviada ao cliente
  VIEWED      /// Visualizada
  CLOSED_WON  /// Fechada (Ganha)
  CLOSED_LOST /// Perdida
}

enum Recurrence {
  AVULSO      /// Pagamento Ãºnico (ex: IRPF, Abertura)
  MENSAL      /// RecorrÃªncia mensal (ex: HonorÃ¡rios)
  TRIMESTRAL  /// RecorrÃªncia trimestral
  ANUAL       /// RecorrÃªncia anual (ex: DASN, BalanÃ§o)
}
// =================================================================
// ðŸ†• SPRINT B1 â€” TIPOS CONTRATAIS (Fase B â€” Pessoas)
// =================================================================
enum ContractType {
  CLT           /// Celetista (padrÃ£o brasileiro)
  ESTAGIARIO    /// EstagiÃ¡rio (Lei 11.788/2008)
  TERCEIRIZADO  /// Terceirizado/PJ (Lei 6.019/1974)
  SOCIO         /// SÃ³cio com prÃ³-labore
}

// =================================================================
// ðŸ¢ EMPRESA (TENANT / MULTI-TENANT)
// =================================================================
/// Representa o escritÃ³rio contÃ¡bil (Tenant). 
/// Todos os dados do sistema sÃ£o isolados por companyId.
model Company {
  id                String   @id @default(uuid())
  name              String   
  cnpj              String?  @unique
  state             String?
  
  email             String?
  phone             String?
  address           String?
  logoUrl           String?
  // ðŸ†• Sprint A5 â€” White-label da proposta pÃºblica
  primaryColor      String?   // Cor primÃ¡ria (ex: "#dc2626"). Null = fallback teal #0d9488
  secondaryColor    String?   // Cor de destaque (ex: "#facc15"). Null = fallback laranja #f97316
  proposalFooterText String?  @db.Text  // Texto opcional no rodapÃ© da proposta

  softwareStack     String[] @default([])
  businessGoals     String?  @db.Text
  
  /// Plano de assinatura do prÃ³prio escritÃ³rio na plataforma Radar
  plan              String   @default("BASIC") 
  allowedModules    String[] @default(["dashboard", "pessoas", "clientes"]) 
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?
  
  users             User[]
  turnoverDistributions TurnoverSectorDistribution[] 
  
  // CatÃ¡logo de ServiÃ§os
  serviceCategories ServiceCategory[]
  serviceItems      ServiceItem[]
  commercialPlans   CommercialPlan[]
  
  // PrecificaÃ§Ã£o
  pricingConfigs      PricingConfig?
  pricingHourRules    PricingHourRule[]
  pricingCalculations PricingCalculation[]
  
  // Comercial
  proposals           Proposal[]
  
  // BI e MÃ©tricas
  clientMonthlyData   ClientMonthlyData[]
  
  // Planejamento EstratÃ©gico
  planningCycles      PlanningCycle[]
  planningAreas       PlanningArea[]
  planningObjectives  PlanningObjective[]
  planningGoals       PlanningGoal[]
  planningKpis        PlanningKPI[]
  actionPlans         ActionPlan[]

  // ContÃ¡bil
  accountingAccounts  AccountingAccount[]
  accountingEntries   AccountingEntry[]
  
  // Contratos
  clientContracts     ClientContract[]
  clientServices      ClientService[]

  // Projetos e Tarefas
  projects        Project[]
  tasks           Task[]

   // ðŸ“¦ MÃ³dulo Fiscal
  fiscalSuppliers       FiscalSupplier[]
  fiscalProducts        FiscalProduct[]
  fiscalInvoices        FiscalInvoice[]
  fiscalMovements       FiscalInventoryMovement[]
  fiscalBalances        FiscalInventoryBalance[]
  fiscalApurations    FiscalIcmsApuration[]
  bankStatements      BankStatement[]
  fiscalServiceInvoices FiscalServiceInvoice[]   // ðŸ†• FD-3a
  taxGuides           TaxGuide[]                 // ðŸ†• FD-4
  // ðŸ†• Sprint C3: indicadores customizados do diretor
  customIndicators CustomIndicator[]

  // ðŸ¤– FuncionÃ¡rio Digital (FD-1)
  robotWorker       RobotWorker?
    // ðŸ“Š RelatÃ³rios Mensais (FD-2 final)
  monthlyReports  MonthlyReport[]
  @@map("companies")
}

// =================================================================
// ðŸ‘¤ USUÃRIO
// =================================================================
model User {
  id                    String                @id @default(uuid())
  name                  String
  email                 String                @unique
  password              String
  role                  UserRole              @default(USER) 
  companyId             String
  company               Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?

  companyProfile        CompanyProfile?
  employees             Employee[]
  clients               Client[]
  pricings              Pricing[]
  plannings             Planning[]
  financialTransactions FinancialTransaction[]
  turnoverMonthly       TurnoverMonthly[]
  sectors               Sector[]
  dismissalReasons      DismissalReason[]
  positions             Position[]
  resignations          Resignation[]
  turnoverDistributions TurnoverSectorDistribution[] 
  
  pricingCalculations   PricingCalculation[]
  proposals             Proposal[]
  clientMonthlyData     ClientMonthlyData[]

  // Tarefas atribuÃ­das
assignedTasks   Task[]
  // ðŸ†• Sprint C3: indicadores que o usuÃ¡rio criou
  customIndicators CustomIndicator[]
  
  @@index([companyId])
  @@map("users")
}

// =================================================================
// ðŸ“Š PERFIL DA EMPRESA (ONBOARDING)
// =================================================================
model CompanyProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  razaoSocial         String?
  cnpj                String?
  estado              String?
  
  softwareConsultoria Boolean  @default(false)
  softwareContabil    Boolean  @default(false)
  softwareFiscal      Boolean  @default(false)
  
  clientesHoje        Int      @default(0)
  clientesAno         Int      @default(0)
  funcionariosHoje    Int      @default(0)
  funcionariosAno     Int      @default(0)
  visaoEmpresa        String?
  maiorDesafio        String?
  compromisso         String?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("company_profiles")
}

// =================================================================
// ðŸ‘· COLABORADOR
// =================================================================
model Employee {
  id              String         @id @default(uuid())
  userId          String
  companyId       String   
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name            String
  email           String?
  phone           String?
  position        String
  department      String?
  admissionDate   DateTime
  dismissalDate   DateTime?
  salary          Float?
  status          EmployeeStatus @default(ACTIVE)
  contractType    ContractType   @default(CLT)  // ðŸ†• Sprint B1: tipo contratual
  isCritical      Boolean        @default(false)
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  @@index([userId])
  @@index([companyId])
  @@map("employees")
}

// =================================================================
// ðŸ¢ CLIENTE
// =================================================================
model Client {
  id                    String                @id @default(uuid())
  userId                String
  companyId             String                
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  companyName           String
  cnpj                  String?
  serviceType           ServiceType           @default(CONTABIL)
  monthlyFee            Float                 /// HonorÃ¡rio atual (snapshot)
  status                ClientStatus          @default(ATIVO)
  
  startDate             DateTime
  endDate               DateTime?
  
  contactName           String?
  contactEmail          String?
  contactPhone          String?
  
    observations          String?               @db.Text

  // ðŸ†• Sprint 23: dados contratuais importados (planilha de honorÃ¡rios)
  lastPaymentDate       DateTime?
  installments          Int?
  openAmount            Float?
  paidAmount            Float?
  overdueAmount         Float?
  
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  deletedAt             DateTime?
  
  financialTransactions FinancialTransaction[]
  accountingEntries     AccountingEntry[]     
  
  // RelaÃ§Ãµes Contratuais
  contracts             ClientContract[]
  services              ClientService[]
  
  // Projetos e Tarefas
  projects              Project[]
  tasks                 Task[]

  // ðŸ“¦ Sprint 8: VÃ­nculo do Estoque Fiscal ao Cliente
  fiscalProducts        FiscalProduct[]
  fiscalInvoices        FiscalInvoice[]
  fiscalMovements       FiscalInventoryMovement[]
  fiscalApurations      FiscalIcmsApuration[]
  bankStatements        BankStatement[]
  // ðŸ“Š RelatÃ³rios mensais do cliente
  monthlyReports  MonthlyReport[]
  fiscalServiceInvoices FiscalServiceInvoice[]   // ðŸ†• FD-3a
  taxGuides           TaxGuide[]                 // ðŸ†• FD-4

  @@index([userId])
  @@unique([companyId, companyName])  // ðŸ†• FD-2: upsert seguro por (tenant + nome)
  @@map("clients")
}

// =================================================================
// ðŸ“¦ CATÃLOGO DE SERVIÃ‡OS (O CORAÃ‡ÃƒO DO SaaS)
// =================================================================

/// Categorias de ServiÃ§os (Ex: Fiscal, DP, ContÃ¡bil, MEI)
model ServiceCategory {
  id          String        @id @default(uuid())
  companyId   String
  name        String
  icon        String?
  order       Int           @default(0)
  description String?
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items       ServiceItem[]
  
  @@index([companyId])
  @@map("service_categories")
}

/// Item de ServiÃ§o (O que Ã© vendido)
model ServiceItem {
  id          String            @id @default(uuid())
  companyId   String
  categoryId  String
  
  name        String            /// Ex: "DeclaraÃ§Ã£o Anual DASN-SIMEI"
  description String?           /// DescriÃ§Ã£o curta para o cliente
  
  /// Escopo detalhado (O que estÃ¡ incluso)
  scope       String?           @db.Text
  /// O que NÃƒO estÃ¡ incluso (Gera cobranÃ§a extra)
  outOfScope  String?           @db.Text
  /// Documentos que o cliente precisa enviar
  requiredDocs String?          @db.Text
  
  basePrice   Decimal           @db.Decimal(10, 2) /// Valor de tabela
  estimatedHours Float          /// Horas estimadas para precificaÃ§Ã£o
  slaDays     Int               @default(5)        /// Prazo de entrega em dias
  
  recurrence  Recurrence        @default(MENSAL)
  
  order       Int               @default(0)
  isActive    Boolean           @default(true)
  
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    ServiceCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  planItems   PlanServiceItem[]
  proposalItems ProposalItem[]
  clientServices ClientService[]
  
  @@index([companyId])
  @@index([categoryId])
  @@map("service_items")
}

// =================================================================
// ðŸ’¼ PLANOS COMERCIAIS (PACOTES)
// =================================================================

/// Plano Comercial (Ex: Plano MEI Essencial, Plano Lucro Presumido)
model CommercialPlan {
  id            String            @id @default(uuid())
  companyId     String
  name          String
  multiplier    Float             @default(1.0) /// Multiplicador sobre o custo base
  order         Int               @default(0)
  isIndependent Boolean           @default(false)
  color         String?
  badge         String?
  description   String?           @db.Text
  
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?
  
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planItems     PlanServiceItem[]
  contracts     ClientContract[]
  proposalItems ProposalItem[]
  
  @@index([companyId])
  @@map("commercial_plans")
}

/// VÃ­nculo N:N entre Plano e Itens de ServiÃ§o
model PlanServiceItem {
  id            String        @id @default(uuid())
  planId        String
  serviceItemId String
  
  quantity      Int           @default(1)
  discount      Float         @default(0)
  
  createdAt     DateTime      @default(now())
  
  plan          CommercialPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  serviceItem   ServiceItem    @relation(fields: [serviceItemId], references: [id], onDelete: Cascade)
  
  @@unique([planId, serviceItemId])
  @@index([planId])
  @@index([serviceItemId])
  @@map("plan_service_items")
}

// =================================================================
// ðŸ“ CONTRATO DO CLIENTE (HISTÃ“RICO E VIGÃŠNCIA)
// =================================================================

/// Contrato vinculando o Cliente a um Plano Comercial
model ClientContract {
  id                String   @id @default(uuid())
  companyId         String
  clientId          String
  commercialPlanId  String
  
  startDate         DateTime
  endDate           DateTime?
  
  monthlyFee        Decimal  @db.Decimal(10, 2)
  status            String   @default("ATIVO") /// ATIVO, SUSPENSO, CANCELADO
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client            Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  commercialPlan    CommercialPlan @relation(fields: [commercialPlanId], references: [id], onDelete: Restrict)
  
  @@index([companyId])
  @@index([clientId])
  @@map("client_contracts")
}

/// ServiÃ§os Avulsos ou Recorrentes contratados FORA do plano principal
model ClientService {
  id              String     @id @default(uuid())
  companyId       String
  clientId        String
  serviceItemId   String
  
  //customPrice     Decimal?   @db.Decimal(10, 2)
  recurrence      Recurrence
  status          String     @default("ATIVO")
  
  startDate       DateTime
  endDate         DateTime?
  
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  
  company         Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client          Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceItem     ServiceItem @relation(fields: [serviceItemId], references: [id], onDelete: Restrict)
  
  @@index([companyId])
  @@index([clientId])
  @@map("client_services")
}

// =================================================================
// ðŸ’° PRECIFICAÃ‡ÃƒO E PROPOSTAS
// =================================================================

/// CÃ¡lculo de PrecificaÃ§Ã£o (Rascunho/SimulaÃ§Ã£o)
model PricingCalculation {
  id                String   @id @default(uuid())
  companyId         String
  userId            String
  
  proposalNumber    String?
  clientName        String
  
  taxRegime         String
  annex             String?
  activity          String
  monthlyRevenue    Float
  employeeCount     Int
  dpMethod          String   @default("MARGIN")
  dpValue           Float    @default(0)
  hasBranches       Boolean  @default(false)
  hasErp            Boolean  @default(false)
  
  hoursFiscal       Float    @default(0)
  hoursAccounting   Float    @default(0)
  costPerHour       Float    @default(0)
  basePrice         Float    @default(0)
  currentCharge     Float?
  
  planPrices        Json?
  
  status            String   @default("DRAFT")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([companyId])
  @@index([status])
  @@map("pricing_calculations")
}

/// Proposta Comercial Enviada ao Cliente
model Proposal {
  id                String         @id @default(uuid())
  companyId         String
  userId            String
  
  proposalNumber    String         @unique
  slug              String         @unique
  clientName        String
  clientCnpj        String?
  
  taxRegime         String
  activity          String
  monthlyRevenue    Float
  employeeCount     Int
  basePrice         Float
  
  // TEXTOS DA PROPOSTA
  aboutOffice       String?        @db.Text
  differentials     String?        @db.Text
  onboarding        String?        @db.Text
  commercialTerms   String?        @db.Text
  specificNote      String?        @db.Text
  
  status            ProposalStatus @default(DRAFT)
  sentAt            DateTime?
  closedAt          DateTime?
  closedPlanId      String?
  closedPrice       Float?
  closingDetails    Json?          // ðŸ†• A4: memÃ³ria do fechamento (desconto, ganho, steps)
  lossReason        String?
  
  views             Int            @default(0)
  whatsappClicks    Int            @default(0)
  
  // ðŸ†• SPRINT A3: Controle de VersÃµes
  version           Int            @default(1)        // NÃºmero da versÃ£o (1, 2, 3...)
  isCurrent         Boolean        @default(true)     // true = versÃ£o ativa do cliente
  originalProposalId String?                          // ID da primeira versÃ£o da cadeia (para agrupar)
  originalProposal  Proposal?      @relation("ProposalVersions", fields: [originalProposalId], references: [id], onDelete: SetNull)
  versions          Proposal[]     @relation("ProposalVersions") // Outras versÃµes desta proposta
  
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  
  company           Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  items             ProposalItem[]
  
  @@index([companyId])
  @@index([userId])
  @@index([status])
  @@index([originalProposalId])
  @@index([isCurrent])
  @@map("proposals")
}
/// Itens dentro da Proposta (Substitui o JSON antigo)
model ProposalItem {
  id                String   @id @default(uuid())
  proposalId        String
  
  /// Pode ser um Plano inteiro ou um ServiÃ§o avulso
  commercialPlanId  String?
  serviceItemId     String?
  
  quantity          Int      @default(1)
  unitPrice         Decimal  @db.Decimal(10, 2)
  totalPrice        Decimal  @db.Decimal(10, 2)
  
  createdAt         DateTime @default(now())
  
  proposal          Proposal       @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  commercialPlan    CommercialPlan? @relation(fields: [commercialPlanId], references: [id], onDelete: SetNull)
  serviceItem       ServiceItem?   @relation(fields: [serviceItemId], references: [id], onDelete: SetNull)
  
  @@index([proposalId])
  @@map("proposal_items")
}

// =================================================================
// ðŸ“Š DADOS MENSAIS DA CARTEIRA (BI / MRR / CHURN)
// =================================================================
model ClientMonthlyData {
  id              String   @id @default(uuid())
  companyId       String
  userId          String
  
  year            Int
  month           Int
  
  initialClients  Int      @default(0)
  newClients      Int      @default(0)
  churnedClients  Int      @default(0)
  finalClients    Int      @default(0)
  
  newRevenue      Float    @default(0)
  lostRevenue     Float    @default(0)
  finalRevenue    Float    @default(0)
  
  churnRate       Float    @default(0)
  accumulatedChurn Float   @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([companyId, year, month])
  @@index([companyId])
  @@index([userId])
  @@map("client_monthly_data")
}

// =================================================================
// ðŸ’¸ FINANCEIRO E CONTÃBIL
// =================================================================
model FinancialTransaction {
  id          String          @id @default(uuid())
  userId      String
  companyId   String   
  clientId    String?
  
  type        TransactionType 
  category    String
  description String
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime        @default(now())
  
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  client      Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  
  @@index([companyId])
  @@index([userId, date])
  @@map("financial_transactions")
}

model AccountingEntry {
  id                  String   @id @default(uuid())
  companyId           String
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  entryDate           DateTime
  description         String
  documentNumber      String?
  counterpartyName    String?
  counterpartyCpfCnpj String?
  counterpartyType    String?
  
  clientId            String?
  bankTransactionId   String?   /// ðŸ†• Sprint 25.2: vÃ­nculo Ã  transaÃ§Ã£o bancÃ¡ria de origem
  client              Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  
  debitAccountId      String?
  debitAccount        AccountingAccount? @relation("DebitEntries", fields: [debitAccountId], references: [id])
  debitValue          Decimal  @default(0) @db.Decimal(12, 2)
  
  creditAccountId     String?
  creditAccount       AccountingAccount? @relation("CreditEntries", fields: [creditAccountId], references: [id])
  creditValue         Decimal  @default(0) @db.Decimal(12, 2)
  
  source              String   @default("MANUAL")
  status              String   @default("PENDENTE")
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([entryDate])
  @@map("accounting_entries")
}

model AccountingAccount {
  id          String          @id @default(uuid())
  companyId   String?         /// NULL = conta global/padrÃ£o do sistema
  code        String   
  name        String   
  type        AccountType   
  nature      AccountNature   
  level       Int             @default(1)
  parentId    String?
  isActive    Boolean         @default(true)
  sciCode     String?  
  reducedCode Int?   // âœ… cÃ³digo reduzido SCI p/ match + exportaÃ§Ã£o

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  
  company     Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent      AccountingAccount? @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    AccountingAccount[] @relation("AccountHierarchy")
  debitEntries  AccountingEntry[] @relation("DebitEntries")
  creditEntries AccountingEntry[] @relation("CreditEntries")
   
  @@unique([companyId, code])  // ðŸ”¥ NOVA CONSTRAINT: Garante unicidade por empresa
  @@index([companyId])
  @@index([code])
  @@map("accounting_accounts")
}
