// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
/// Representa a funcionÃ¡ria digital do escritÃ³rio.
/// Ã‰ criada automaticamente no primeiro acesso (lazy).
/// companyId Ãºnico = ADR-004 (multi-tenant single-database).
model RobotWorker {
  id        String            @id @default(cuid())
  companyId String            @unique
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name      String            @default("Aurora")
  avatar    String            @default("ðŸŒ…")       /// Emoji do avatar
  status    RobotWorkerStatus @default(ACTIVE)

  /// JSON com configuraÃ§Ãµes globais da Aurora (ex.: timezone, idioma)
  config    Json              @default("{}")

  skills    RobotWorkerSkill[]
  runs      AutomationRun[]

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@map("robot_workers")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// ðŸ§© SKILL DA AURORA (1 por tipo, com cron individual)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
/// Cada habilidade pode ser ligada/desligada e tem seu prÃ³prio cron.
/// cronExpr usa formato POSIX cron (ex.: "0 2 * * *" = todo dia 02:00).
/// riskLevel=LEGAL forÃ§a REVIEW independente do score (Regra de Ouro).
model RobotWorkerSkill {
  id          String         @id @default(cuid())
  companyId   String
  workerId    String
  worker      RobotWorker    @relation(fields: [workerId], references: [id], onDelete: Cascade)

  skillKey    SkillKey
  enabled     Boolean        @default(false)       /// Liga/desliga pelo painel
  cronExpr    String         @default("0 2 * * *") /// Cron POSIX
  autonomy    AutonomyLevel  @default(REVIEW)      /// ADR-030

  /// ParÃ¢metros especÃ­ficos da skill (ex.: clientId-alvo, tolerÃ¢ncias)
  params      Json           @default("{}")

  lastRunAt   DateTime?
  lastRunId   String?        /// ID do Ãºltimo AutomationRun

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([companyId, skillKey])   /// 1 skill por tenant por tipo
  @@index([companyId, enabled])
  @@map("robot_worker_skills")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// ðŸ“‹ EXECUÃ‡ÃƒO (o "ponto" da Aurora)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
/// Cada vez que uma skill Ã© executada (cron ou botÃ£o manual),
/// uma linha Ã© criada aqui. Ã‰ a prova do que a Aurora fez.
model AutomationRun {
  id                String      @id @default(cuid())
  companyId         String
  workerId          String
  worker            RobotWorker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  skillKey          SkillKey
  triggerType       String      @default("CRON")    /// CRON | MANUAL | WEBHOOK
  triggeredBy       String?     /// userId (se manual) ou "SYSTEM"

  status            RunStatus   @default(RUNNING)

  startedAt         DateTime    @default(now())
  finishedAt        DateTime?

  /// MÃ©tricas da execuÃ§Ã£o (o que o dashboard exibe)
  itemsProcessed    Int         @default(0)
  itemsAutoApproved Int         @default(0)         /// score â‰¥80%
  itemsPendingHuman Int         @default(0)         /// 50â€“79% â†’ fila
  itemsFailed       Int         @default(0)
  secondsSaved      Int         @default(0)         /// mÃ©trica de marketing

  errorMessage      String?     @db.Text

  pendings          AutomationPending[]
  monthlyReports    MonthlyReport[]   // ðŸ†• FD-2 final: relatÃ³rios gerados por este run

  @@index([companyId, startedAt])
  @@index([companyId, status])
  @@index([workerId])
  @@map("automation_runs")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
// ðŸŸ¡ FILA DE REVISÃƒO (human-in-the-loop â€” Pilar B)
// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
/// Itens que a Aurora nÃ£o teve confianÃ§a suficiente para decidir
/// sozinha. O contador revisa, aprova ou rejeita.
/// type = MATCH | CLASSIFICATION | DIVERGENCE | GUIDE_REVIEW etc.
/// payload = JSON com os dados especÃ­ficos (ids, scores, sugestÃµes).
model AutomationPending {
  id         String        @id @default(cuid())
  companyId  String
  runId      String?
  run        AutomationRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  type       String                                  /// MATCH, CLASSIFICATION, etc.
  confidence Float?                                  /// 0â€“100 (score da sugestÃ£o)

  /// JSON com os dados da pendÃªncia (ex.: {bankTxId, invoiceId, breakdown})
  payload    Json

  status     PendingStatus @default(PENDING)
  resolvedBy String?       /// userId que resolveu
  resolvedAt DateTime?
  notes      String?       @db.Text

  createdAt  DateTime      @default(now())

  @@index([companyId, status])
  @@index([companyId, type])
  @@index([runId])
  @@map("automation_pendings")
}

