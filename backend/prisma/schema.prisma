generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =================================================================
// 🏢 EMPRESA (TENANT)
// =================================================================
model Company {
  id              String   @id @default(uuid())
  name            String   
  cnpj            String?  @unique
  state           String?
  
  plan            String   @default("BASIC") 
  allowedModules  String[] @default(["dashboard", "pessoas", "clientes"]) 
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  users           User[]
  turnoverDistributions TurnoverSectorDistribution[] // 🔥 CORREÇÃO: Relação inversa adicionada
  
  @@map("companies")
}

// =================================================================
// 👤 USUÁRIO
// =================================================================
model User {
  id                    String                @id @default(uuid())
  name                  String
  email                 String                @unique
  password              String
  role                  String                @default("CLIENTE") 
  companyId             String
  company               Company               @relation(fields: [companyId], references: [id])
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  companyProfile        CompanyProfile?
  employees             Employee[]
  clients               Client[]
  pricings              Pricing[]
  plannings             Planning[]
  financialTransactions FinancialTransaction[]
  turnoverMonthly       TurnoverMonthly[]
  sectors               Sector[]
  dismissalReasons      DismissalReason[]
  positions             Position[]
  resignations          Resignation[]
  turnoverDistributions TurnoverSectorDistribution[] 

  @@index([companyId])
  @@map("users")
}

// =================================================================
// 📊 PERFIL DA EMPRESA
// =================================================================
model CompanyProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id])
  
  razaoSocial         String?
  cnpj                String?
  estado              String?
  
  softwareConsultoria Boolean  @default(false)
  softwareContabil    Boolean  @default(false)
  softwareFiscal      Boolean  @default(false)
  
  clientesHoje        Int      @default(0)
  clientesAno         Int      @default(0)
  funcionariosHoje    Int      @default(0)
  funcionariosAno     Int      @default(0)
  visaoEmpresa        String?
  maiorDesafio        String?
  compromisso         String?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("company_profiles")
}

// =================================================================
// 👷 COLABORADOR
// =================================================================
model Employee {
  id              String   @id @default(uuid())
  userId          String
  companyId       String   
  user            User     @relation(fields: [userId], references: [id])
  
  name            String
  email           String?
  phone           String?
  position        String
  department      String?
  admissionDate   DateTime
  dismissalDate   DateTime?
  salary          Float?
  status          String   @default("ACTIVE")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([companyId])
  @@map("employees")
}

// =================================================================
// 🏢 CLIENTE
// =================================================================
model Client {
  id                    String                @id @default(uuid())
  userId                String
  companyId             String                
  user                  User                  @relation(fields: [userId], references: [id])
  
  companyName           String
  cnpj                  String?
  serviceType           String                @default("CONTABIL")
  monthlyFee            Float
  status                String                @default("ATIVO")
  
  startDate             DateTime
  endDate               DateTime?
  
  contactName           String?
  contactEmail          String?
  contactPhone          String?
  
  observations          String?               @db.Text
  
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  
  financialTransactions FinancialTransaction[]

  @@index([userId])
  @@index([companyId])
  @@map("clients")
}

// =================================================================
// 💰 PRECIFICAÇÃO
// =================================================================
model Pricing {
  id              String   @id @default(uuid())
  userId          String
  companyId       String   
  user            User     @relation(fields: [userId], references: [id])
  
  title           String
  serviceType     String   @default("CONTABIL")
  complexity      String   @default("MEDIA")
  
  estimatedHours  Float
  hourlyRate      Float
  softwareCost    Float    @default(0)
  profitMargin    Float    @default(20)
  
  finalValue      Float
  status          String   @default("RASCUNHO")
  
  observations    String?  @db.Text
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([companyId])
  @@map("pricings")
}

// =================================================================
// 📋 PLANEJAMENTO
// =================================================================
model Planning {
  id              String   @id @default(uuid())
  userId          String
  companyId       String   
  user            User     @relation(fields: [userId], references: [id])
  
  title           String
  description     String?  @db.Text
  category        String   @default("GERAL")
  targetDate      DateTime
  status          String   @default("PENDENTE")
  progress        Float    @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([companyId])
  @@map("plannings")
}

// =================================================================
// 💸 TRANSAÇÃO FINANCEIRA
// =================================================================
model FinancialTransaction {
  id          String   @id @default(uuid())
  userId      String
  companyId   String   
  clientId    String?
  
  type        String   
  category    String
  description String
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime @default(now())
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([companyId])
  @@index([userId, date])
  @@index([userId, type])
  @@index([clientId])
  @@map("financial_transactions")
}

// =================================================================
// 📊 TURNOVER - Dados Mensais
// =================================================================
model TurnoverMonthly {
  id          String   @id @default(uuid())
  userId      String
  companyId   String   
  year        Int
  month       Int      
  
  cltInitial      Int @default(0)
  cltAdmissions   Int @default(0)
  cltDismissals   Int @default(0)
  
  internInitial   Int @default(0)
  internAdmissions Int @default(0)
  internDismissals Int @default(0)
  
  thirdInitial    Int @default(0)
  thirdAdmissions Int @default(0)
  thirdDismissals Int @default(0)
  
  partnerInitial  Int @default(0)
  partnerAdmissions Int @default(0)
  partnerDismissals Int @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([companyId, year, month])
  @@index([userId])
  @@index([companyId])
  @@map("turnover_monthly")
}

// =================================================================
// 🏢 SETOR
// =================================================================
model Sector {
  id        String   @id @default(uuid())
  userId    String
  companyId String   
  name      String
  mandatory Boolean  @default(false)
  order     Int      @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user                User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cells               Cell[]
  resignations        Resignation[]
  turnoverDistributions TurnoverSectorDistribution[] 
  
  @@index([userId])
  @@index([companyId])
  @@map("sectors")
}

// =================================================================
// 🔲 CÉLULA DE TRABALHO
// =================================================================
model Cell {
  id        String   @id @default(uuid())
  sectorId  String
  name      String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  sector    Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  
  @@map("cells")
}

// =================================================================
// 📋 MOTIVO DE DESLIGAMENTO
// =================================================================
model DismissalReason {
  id          String   @id @default(uuid())
  userId      String
  companyId   String   
  name        String
  description String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resignations Resignation[]
  
  @@index([userId])
  @@index([companyId])
  @@map("dismissal_reasons")
}

// =================================================================
// 💼 CARGO
// =================================================================
model Position {
  id        String   @id @default(uuid())
  userId    String
  companyId String   
  name      String
  description String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resignations Resignation[]
  
  @@index([userId])
  @@index([companyId])
  @@map("positions")
}

// =================================================================
// 📤 RESCISÃO
// =================================================================
model Resignation {
  id              String   @id @default(uuid())
  userId          String
  companyId       String   
  
  employeeName    String
  admissionDate   DateTime
  dismissalDate   DateTime
  
  sectorId        String?
  sector          Sector?  @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  
  cellId          String?
  
  positionId      String?
  position        Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)
  
  contractType    String   
  dismissalReasonId String?
  dismissalReason DismissalReason? @relation(fields: [dismissalReasonId], references: [id], onDelete: SetNull)
  
  observations    String?  @db.Text
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([companyId])
  @@index([dismissalDate])
  @@map("resignations")
}

// =================================================================
// 📊 DISTRIBUIÇÃO DE TURNOVER POR SETOR
// =================================================================
model TurnoverSectorDistribution {
  id          String   @id @default(uuid())
  companyId   String
  userId      String
  year        Int
  month       Int      
  sectorId    String
  
  initial     Int      @default(0)
  admissions  Int      @default(0)
  dismissals  Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector      Sector   @relation(fields: [sectorId], references: [id], onDelete: Cascade)
  
  @@unique([companyId, year, month, sectorId])
  @@index([companyId])
  @@map("turnover_sector_distribution")
}